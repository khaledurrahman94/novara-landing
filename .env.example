# Copy to .env (git-ignored) for local builds. Real environment variables win over this file.
# Full list and where each one is set: docs/deploy-site.md

# production | staging. Anything but "production" renders noindex,nofollow and robots.txt "Disallow: /".
PUBLIC_SITE_ENV=staging

# Build input: the Strapi site and a READ-ONLY API token ("find" on site-settings, redirect and the page types).
STRAPI_URL=
STRAPI_TOKEN=

# No Strapi yet? Build from local fixtures instead (staging only; production refuses it).
# STRAPI_FIXTURES=fixtures/strapi/good

# Run the production-only checks on a staging build (preflight), e.g. robots.txt must not disallow "/".
# VALIDATE_AS=production

# Preview route (/preview/*), read at runtime by the Worker: set in Cloudflare, or in .dev.vars for local runs.
# PREVIEW_SECRET is what Strapi's Preview button puts in ?secret=. STRAPI_PREVIEW_TOKEN is a separate token that can read drafts.
PREVIEW_SECRET=
STRAPI_PREVIEW_TOKEN=
