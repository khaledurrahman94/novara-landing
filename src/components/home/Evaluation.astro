---
import Icon from '../shared/ui/Icon.astro';
import { home } from '../../content/home';
import { STRONG_AT } from './labs/screening/model';
/**
 * A candidate evaluation shaped like the dashboard's Evaluation tab: AI Interview Score and Job Fit Score
 * as percentages, then Strengths, Weaknesses, Opportunities and Threats. The wording is illustrative.
 */
interface Props { name: string; jobFit: number; score: number; swot: { strengths: string; weaknesses: string; opportunities: string; threats: string }; class?: string }
const { name, jobFit, score, swot, class: cls = '' } = Astro.props;
const { evaluation } = home.decide;
const chip = (n: number) => (n >= STRONG_AT ? 'bg-success/10 text-success' : 'bg-warning/10 text-warning');
const rows = [
  { key: 'strengths', label: evaluation.strengths, text: swot.strengths },
  { key: 'weaknesses', label: evaluation.weaknesses, text: swot.weaknesses },
  { key: 'opportunities', label: evaluation.opportunities, text: swot.opportunities },
  { key: 'threats', label: evaluation.threats, text: swot.threats },
] as const;
---
<div class:list={['w-full rounded-lg border border-border-secondary bg-white p-5 font-ui text-text-primary shadow-md', cls]}>
  <p class="m-0 text-sm font-semibold">{name}</p>
  <div class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
    <div>
      <p class="m-0 text-[0.6875rem] font-medium uppercase tracking-wide text-text-tertiary">{evaluation.interviewScore}</p>
      <p class="m-0 mt-1"><span class:list={['inline-block rounded-md px-2 py-0.5 text-lg font-semibold tabular-nums', chip(score)]}><span data-evidence-score data-count={score}>{score}</span>%</span></p>
    </div>
    <div>
      <p class="m-0 text-[0.6875rem] font-medium uppercase tracking-wide text-text-tertiary">{evaluation.fitScore}</p>
      <p class="m-0 mt-1"><span class:list={['inline-block rounded-md px-2 py-0.5 text-lg font-semibold tabular-nums', chip(jobFit)]}>{jobFit}%</span></p>
    </div>
  </div>
  <ul class="m-0 mt-4 flex list-none flex-col gap-2.5 border-t border-border-secondary p-0 pt-4">
    {rows.map((r) => (
      <li class="flex items-start gap-2.5 text-[0.8125rem] leading-snug">
        <span class="mt-px grid size-5 shrink-0 place-items-center rounded-full bg-gray-100 text-text-secondary"><Icon name="check" size={12} /></span>
        <span><span class="font-semibold text-text-primary">{r.label}</span> <span class="text-text-secondary">{r.text}</span></span>
      </li>
    ))}
  </ul>
</div>
