---
import { home } from '../../content/home';
import Section from './Section.astro';
import Button from './Button.astro';
const { close, form } = home;
---
<Section id="demo-close" labelledby="close-title">
  <div class="mx-auto flex max-w-[64rem] flex-col items-center text-center">
    <h2 id="close-title" class="m-0 text-balance text-[clamp(2rem,1.2rem+2.8vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.03em]">{close.title}</h2>
    <p class="m-0 mt-5 max-w-[40rem] text-lg leading-relaxed text-text-secondary">{close.line}</p>
    <div class="mt-8 flex w-full justify-center">
      <Button href="/contact">{form.submit}</Button>
    </div>
  </div>
</Section>
