---
import { home } from '../../content/home';
import Section from './Section.astro';
/**
 * Trust strip after the hero. Renders only when `home.socialProof.logos` has real entries,
 * so it ships empty. No invented customers, counts or quotes: see docs/implementation/06-dm-feedback.md.
 */
const { heading, count, logos } = home.socialProof;
const show = logos.length > 0;
---
{show && (
  <Section id="trust" labelledby="trust-title" tone="white" innerClass="py-10! md:py-14!">
    <div class="flex flex-col items-center gap-8 text-center">
      <div>
        <h2 id="trust-title" class="m-0 text-sm font-medium text-text-secondary">{heading}</h2>
        {count && <p class="m-0 mt-1 text-sm text-text-tertiary">{count}</p>}
      </div>
      <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-10 gap-y-6 p-0">
        {logos.map((l) => (
          <li class="flex h-8 items-center">
            {l.href ? (
              <a href={l.href} rel="noopener" class="inline-flex rounded-sm opacity-70 transition-opacity duration-[var(--duration-fast)] hover:opacity-100 focus-visible:opacity-100">
                <img src={l.src} alt={l.name} loading="lazy" class="h-8 w-auto max-w-[10rem] object-contain" />
              </a>
            ) : (
              <img src={l.src} alt={l.name} loading="lazy" class="h-8 w-auto max-w-[10rem] object-contain opacity-70" />
            )}
          </li>
        ))}
      </ul>
    </div>
  </Section>
)}
