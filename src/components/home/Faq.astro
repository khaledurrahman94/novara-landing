---
import { home } from '../../content/home';
import Section from './Section.astro';
const { faq } = home;
---
<Section id="faq" labelledby="faq-title" tone="plate">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <h2 id="faq-title" class="m-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em] lg:col-span-4">{faq.title}</h2>
    <div class="home-faq border-b border-border-secondary lg:col-span-8">
      {faq.items.map((item) => (
        <details class="border-t border-border-secondary">
          <summary class="flex items-center justify-between gap-6 py-5 text-[1.0625rem] font-medium tracking-[-0.01em] text-text-primary">
            {item.q}
            <span class="home-plus grid size-6 shrink-0 place-items-center text-text-tertiary" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="m-0 max-w-[40rem] pb-6 pr-10 text-[0.9375rem] leading-relaxed text-text-secondary">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
