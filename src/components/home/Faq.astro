---
import { home } from '../../content/home';
import Section from './Section.astro';
const { faq } = home;
/** Two balanced columns on md+ (first half left, second half right), so reading order stays top to bottom per column. */
const half = Math.ceil(faq.items.length / 2);
const columns = [faq.items.slice(0, half), faq.items.slice(half)];
---
<Section id="faq" labelledby="faq-title" tone="plate">
  <h2 id="faq-title" class="m-0 text-center text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]">{faq.title}</h2>
  <div class="home-faq mt-10 grid items-start gap-x-12 md:mt-14 md:grid-cols-2 lg:gap-x-16">
    {columns.map((items) => (
      <div class="border-t border-border-secondary max-md:[&:not(:first-child)]:border-t-0">
        {items.map((item) => (
          <details class="border-b border-border-secondary">
            <summary class="flex items-start gap-4 py-5 text-[1.0625rem] font-medium tracking-[-0.01em] text-text-primary">
              <span class="home-plus mt-0.5 grid size-6 shrink-0 place-items-center text-primary" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14" /><path class="home-plus-v" d="M12 5v14" /></svg>
              </span>
              <span class="min-w-0 flex-1">{item.q}</span>
            </summary>
            <p class="m-0 max-w-[40rem] pb-6 pl-10 pr-2 text-[0.9375rem] leading-relaxed text-text-secondary">{item.a}</p>
          </details>
        ))}
      </div>
    ))}
  </div>
</Section>
