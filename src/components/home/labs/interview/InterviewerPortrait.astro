---
import fs from 'node:fs';
import path from 'node:path';
import { lab } from './copy';
/**
 * The AI interviewer, full-bleed. Swappable: drop a generated portrait at public/brand/interviewer.webp and this
 * renders it as an <img> with no code change (checked at build time). Otherwise a vector portrait, head and shoulders
 * with a headset, drawn only from palette tokens (skin is a token mix: warning over white).
 */
const photo = fs.existsSync(path.join(process.cwd(), 'public', 'brand', 'interviewer.webp'));
const alt = lab.candidate.portraitAlt;
---
{photo ? (
  <img src="/brand/interviewer.webp" alt={alt} width="1600" height="1000" decoding="async" class="size-full object-cover object-[50%_30%]" />
) : (
  <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMax slice" role="img" aria-label={alt} class="il-portrait size-full">
    <defs>
      <linearGradient id="ilp-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--color-primary-950)" />
        <stop offset="1" stop-color="var(--color-gray-950)" />
      </linearGradient>
      <radialGradient id="ilp-spot" cx="50%" cy="38%" r="55%">
        <stop offset="0" stop-color="var(--color-primary-700)" stop-opacity="0.75" />
        <stop offset="1" stop-color="var(--color-primary-950)" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="ilp-shirt" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--color-primary-600)" />
        <stop offset="1" stop-color="var(--color-primary-900)" />
      </linearGradient>
      <radialGradient id="ilp-skin" cx="42%" cy="35%" r="75%">
        <stop offset="0" stop-color="var(--ilp-skin-light)" />
        <stop offset="1" stop-color="var(--ilp-skin)" />
      </radialGradient>
      <linearGradient id="ilp-vig" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.55" stop-color="var(--color-gray-950)" stop-opacity="0" />
        <stop offset="1" stop-color="var(--color-gray-950)" stop-opacity="0.65" />
      </linearGradient>
      <filter id="ilp-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="14" /></filter>
      <filter id="ilp-soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6" /></filter>
    </defs>

    <rect width="800" height="500" fill="url(#ilp-bg)" />
    <rect width="800" height="500" fill="url(#ilp-spot)" />
    <!-- Soft out-of-focus room behind the speaker. -->
    <g filter="url(#ilp-blur)" opacity="0.55">
      <rect x="40" y="70" width="150" height="230" rx="14" fill="var(--color-primary-800)" opacity="0.6" />
      <rect x="620" y="110" width="130" height="190" rx="14" fill="var(--color-primary-900)" opacity="0.8" />
      <circle cx="120" cy="360" r="46" fill="var(--color-primary-400)" opacity="0.35" />
      <circle cx="690" cy="70" r="34" fill="var(--color-primary-300)" opacity="0.35" />
      <circle cx="600" cy="400" r="40" fill="var(--color-primary-500)" opacity="0.3" />
    </g>

    <!-- Shoulders and tee. -->
    <path d="M90 500C100 424 190 388 318 374L482 374C610 388 700 424 710 500Z" fill="url(#ilp-shirt)" />
    <path d="M338 372L400 446L462 372Z" fill="var(--color-primary-200)" />
    <path d="M338 372L400 446L400 372Z" fill="var(--color-primary-100)" />
    <!-- Neck. -->
    <path d="M358 318L358 386Q400 428 442 386L442 318Z" fill="var(--ilp-skin-shade)" />
    <path d="M358 360Q400 392 442 360L442 340Q400 372 358 340Z" fill="var(--color-gray-950)" opacity="0.14" />

    <!-- Ears, head, hair. -->
    <ellipse cx="311" cy="228" rx="15" ry="26" fill="var(--ilp-skin-shade)" />
    <ellipse cx="489" cy="228" rx="15" ry="26" fill="var(--ilp-skin-shade)" />
    <ellipse cx="400" cy="214" rx="90" ry="110" fill="url(#ilp-skin)" />
    <path d="M308 206C296 108 346 84 402 84C458 84 506 108 492 206C484 160 458 134 402 132C346 134 316 160 308 206Z" fill="var(--color-gray-950)" />
    <path d="M330 120C360 96 420 92 462 112" stroke="var(--color-primary-400)" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.45" />

    <!-- Face: brows, eyes, nose, cheeks, smile. -->
    <g fill="none" stroke="var(--color-gray-950)" stroke-linecap="round">
      <path d="M342 188Q362 178 382 186" stroke-width="6" opacity="0.85" />
      <path d="M418 186Q438 178 458 188" stroke-width="6" opacity="0.85" />
    </g>
    <g>
      <ellipse cx="362" cy="208" rx="15" ry="9" fill="var(--color-white)" />
      <ellipse cx="438" cy="208" rx="15" ry="9" fill="var(--color-white)" />
      <circle cx="363" cy="208" r="7.5" fill="var(--color-primary-900)" />
      <circle cx="437" cy="208" r="7.5" fill="var(--color-primary-900)" />
      <circle cx="363" cy="208" r="3.6" fill="var(--color-gray-950)" />
      <circle cx="437" cy="208" r="3.6" fill="var(--color-gray-950)" />
      <circle cx="366" cy="205" r="1.8" fill="var(--color-white)" />
      <circle cx="440" cy="205" r="1.8" fill="var(--color-white)" />
      <path d="M346 202Q362 194 378 202" stroke="var(--color-gray-950)" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <path d="M422 202Q438 194 454 202" stroke="var(--color-gray-950)" stroke-width="2.5" fill="none" stroke-linecap="round" />
    </g>
    <path d="M400 214Q391 244 384 254Q400 262 416 254" stroke="var(--ilp-skin-shade)" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <g filter="url(#ilp-soft)" opacity="0.4">
      <circle cx="346" cy="252" r="20" fill="var(--color-warning)" />
      <circle cx="454" cy="252" r="20" fill="var(--color-warning)" />
    </g>
    <path d="M366 274Q400 306 434 274Q400 284 366 274Z" fill="var(--color-white)" stroke="var(--ilp-lip)" stroke-width="5" stroke-linejoin="round" />

    <!-- Headset: band, ear cups, boom mic. -->
    <path d="M306 214C294 70 506 70 494 214" fill="none" stroke="var(--color-gray-800)" stroke-width="13" stroke-linecap="round" />
    <path d="M306 214C298 96 440 74 494 190" fill="none" stroke="var(--color-primary-400)" stroke-width="2.5" stroke-linecap="round" opacity="0.5" />
    <rect x="288" y="186" width="30" height="72" rx="14" fill="var(--color-gray-800)" stroke="var(--color-primary-400)" stroke-width="2.5" />
    <rect x="482" y="186" width="30" height="72" rx="14" fill="var(--color-gray-800)" stroke="var(--color-primary-400)" stroke-width="2.5" />
    <path d="M298 254C300 312 344 326 376 304" fill="none" stroke="var(--color-gray-800)" stroke-width="5" stroke-linecap="round" />
    <circle cx="380" cy="302" r="9" fill="var(--color-gray-950)" stroke="var(--color-gray-400)" stroke-width="1.5" />

    <rect width="800" height="500" fill="url(#ilp-vig)" />
  </svg>
)}

<style is:global>
  .il-portrait {
    --ilp-skin: color-mix(in srgb, var(--color-warning) 34%, var(--color-white));
    --ilp-skin-light: color-mix(in srgb, var(--color-warning) 22%, var(--color-white));
    --ilp-skin-shade: color-mix(in srgb, var(--color-warning) 48%, var(--color-gray-400));
    --ilp-lip: color-mix(in srgb, var(--color-warning) 55%, var(--color-gray-800));
  }
</style>
