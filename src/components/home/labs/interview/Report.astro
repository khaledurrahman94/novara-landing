---
import Evaluation from '../../Evaluation.astro';
import { home } from '../../../../content/home';
import { lead } from '../../../../data/demo';
import { lab, kinds, script, clock, eventTitle } from './copy';
/**
 * The integrity report of the scripted walkthrough. Rendered from the same script the animation plays, so the
 * report and the live counters always agree. `sample` is the static version shown without JavaScript or under
 * reduced motion; the other one sits hidden inside the animated window until the interview ends.
 */
interface Props { sample?: boolean }
const { sample = false } = Astro.props;
const events = script.events;
const count = (k: string): number => events.filter((e) => e.kind === k).length;
const rows = [
  { time: clock(0), label: lab.started, flagged: false },
  ...events.map((e) => ({ time: clock(e.at * 1000), label: eventTitle(e), flagged: true })),
  { time: clock(script.end * 1000), label: lab.ended, flagged: false },
];
---
<div
  data-il-report={sample ? undefined : ''}
  data-il-static={sample ? '' : undefined}
  hidden={!sample}
  class="grid items-start gap-5 font-ui text-text-primary lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]"
>
  <div class="rounded-lg border border-border-secondary bg-bg-secondary p-5 shadow-md sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <h3 class="m-0 text-xl font-semibold tracking-[-0.01em]">{sample ? lab.report.sampleTitle : lab.report.title}</h3>
      <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-warning/10 px-2 py-0.5 text-xs font-medium text-text-secondary">
        <span class="size-1.5 rounded-full bg-warning" aria-hidden="true"></span>
        {lab.review(events.length)}
      </span>
    </div>
    <p class="m-0 mt-1.5 text-[0.9375rem] text-text-secondary">{lab.report.summary(events.length)}</p>

    <ul class="m-0 mt-5 grid list-none grid-cols-2 gap-x-6 gap-y-2 p-0 text-[0.8125rem] sm:grid-cols-4">
      {kinds.map((k) => (
        <li class="flex items-baseline justify-between gap-2 border-b border-border-secondary pb-1.5 text-text-tertiary">
          <span class="truncate">{k.label}</span>
          <span class:list={['font-semibold tabular-nums', count(k.key) > 0 ? 'text-text-primary' : 'text-text-tertiary']}>{count(k.key)}</span>
        </li>
      ))}
    </ul>

    <ol class="m-0 mt-5 list-none p-0">
      {rows.map((r, i) => (
        <li data-il-rrow class="relative flex gap-3 pb-4 last:pb-0">
          {i < rows.length - 1 && <span class="absolute left-[0.3125rem] top-4 h-full w-px bg-border-secondary" aria-hidden="true"></span>}
          <span class:list={['relative mt-1 size-[0.6875rem] shrink-0 rounded-full border-2 bg-bg-secondary', r.flagged ? 'border-warning' : 'border-border-primary']} aria-hidden="true"></span>
          <span class="min-w-0 flex-1 text-[0.8125rem]">
            <span class="mr-2 tabular-nums text-text-tertiary">{r.time}</span>
            <span class:list={[r.flagged ? 'font-semibold text-text-primary' : 'text-text-secondary']}>{r.label}</span>
            {r.flagged && <span class="mt-0.5 block text-xs text-text-tertiary">{lab.flagged}</span>}
          </span>
        </li>
      ))}
    </ol>

    <p class="m-0 mt-5 border-t border-border-secondary pt-4 text-[0.9375rem] font-medium leading-snug text-text-primary">{lab.report.line}</p>
    {sample && <p class="m-0 mt-2 text-xs text-text-tertiary">{lab.report.sampleNote}</p>}
  </div>

  <div class="flex flex-col gap-3">
    <p class="m-0 flex items-center gap-2 text-xs font-medium text-text-tertiary">
      <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-primary-50 px-2 py-0.5 font-medium text-text-secondary">
        <span class="size-1.5 rounded-full bg-primary" aria-hidden="true"></span>{lab.score.chip}
      </span>
    </p>
    <Evaluation name={lead.name} jobFit={home.decide.evidence.amara.jobFit} score={home.decide.evidence.amara.score} swot={home.decide.evidence.amara.swot} />
    <p class="m-0 text-xs leading-snug text-text-tertiary">{lab.score.note}</p>
  </div>
</div>
