---
import { home } from '../../content/home';
import BrandIcon from './BrandIcon.astro';
const { footer } = home;
const contact = footer.contact;
const social = footer.social.filter((s) => s.href);
const ai = footer.aiSummary;
/** Only links whose page exists (`live` in home.ts); a column with no live link is dropped. */
const columns = footer.columns
  .map((col) => ({ label: col.label, links: col.links.filter((l) => l.live) }))
  .filter((col) => col.links.length > 0);
/** Link columns fill the right half of the 12-col grid evenly (up to 3); a lone column sits against the right edge. */
const colsClass = ['', 'md:flex md:justify-end', 'md:grid-cols-2', 'md:grid-cols-3'][Math.min(columns.length, 3)] ?? 'md:grid-cols-3';
const iconLink = 'grid size-9 place-items-center rounded-md border border-border-primary bg-white text-text-secondary shadow-xs transition-colors duration-[var(--duration-fast)] hover:text-text-primary';
---
<footer class="overflow-hidden border-t border-border-secondary bg-bg">
  <div class="mx-auto w-full max-w-[75rem] border-x border-border-secondary px-5 py-14 sm:px-8 md:px-12">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-6">
        <img src="/brand/novara-full.svg" width="143" height="41" alt="Novara" class="block h-7 w-auto" />
        <p class="m-0 mt-4 max-w-[22rem] text-[0.9375rem] leading-relaxed text-text-secondary">{footer.line}</p>
        {social.length > 0 && (
          <div class="mt-6">
            <p class="m-0 text-xs font-semibold text-text-tertiary">{footer.followLabel}</p>
            <ul class="m-0 mt-3 flex list-none gap-2 p-0">
              {social.map((s) => (
                <li><a href={s.href} class={iconLink} rel="noopener" aria-label={s.label}><BrandIcon name={s.key} /></a></li>
              ))}
            </ul>
          </div>
        )}
        {contact && (
          <address class="m-0 mt-6 flex flex-col gap-1.5 text-sm not-italic text-text-secondary">
            <a href={`mailto:${contact.email}`} class="w-fit text-text-secondary no-underline hover:text-text-primary hover:underline">{contact.email}</a>
            <a href={`tel:${contact.phone.replace(/[^+\d]/g, '')}`} class="w-fit text-text-secondary no-underline hover:text-text-primary hover:underline">{contact.phone}</a>
            <span class="max-w-[22rem]">{contact.address}</span>
          </address>
        )}
        <p class="m-0 mt-6">
          <a href={footer.makerHref} class="inline-block no-underline" rel="noopener"><img src={footer.makerImage} alt={footer.maker} class="block h-6 w-auto" loading="lazy" decoding="async" /></a>
        </p>
      </div>
      {columns.length > 0 && (
      <div class:list={['grid gap-10 md:col-span-6 md:gap-8', colsClass]}>
      {columns.map((col) => (
        <nav aria-label={col.label} class={columns.length === 1 ? 'md:min-w-[12rem]' : ''}>
          <p class="m-0 mb-4 text-xs font-semibold text-text-tertiary">{col.label}</p>
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {col.links.map((l) => <li><a href={l.href} class="text-sm text-text-secondary no-underline hover:text-text-primary hover:underline">{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
      </div>
      )}
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-border-secondary pt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      {/* The AI summary links are hidden for now, not removed: drop `hidden` to bring them back. */}
      <div class="hidden flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
      <p id="ai-summary-label" class="m-0 text-sm text-text-secondary">{ai.label}</p>
      <ul aria-labelledby="ai-summary-label" class="m-0 flex list-none gap-2 p-0">
        {ai.assistants.map((a) => (
          <li><a href={`${a.url}${encodeURIComponent(ai.prompt)}`} class={iconLink} target="_blank" rel="noopener noreferrer" aria-label={`${a.label}: ${ai.label}`}><BrandIcon name={a.key} /></a></li>
        ))}
      </ul>
      </div>
      <p class="m-0 text-xs text-text-tertiary sm:ml-auto sm:text-right">
        <a href="/terms" class="text-text-tertiary no-underline hover:text-text-primary hover:underline">{footer.copyright}. {footer.rights}</a>
      </p>
    </div>

  </div>

  <div aria-hidden="true" class="pointer-events-none select-none overflow-hidden [mask-image:linear-gradient(to_bottom,black_15%,transparent_92%)]">
    <p class="m-0 text-center font-display text-[clamp(6rem,25vw,24rem)] font-bold leading-[0.8] tracking-[-0.05em] text-primary-200">Novara</p>
  </div>
</footer>
