---
import { home } from '../../content/home';
import { byId, role } from '../../data/demo';
import { stageTone, toneDot } from '../shared/ui/tone';
import Section from './Section.astro';
import Figure from './Figure.astro';
import Avatar from '../shared/ui/Avatar.astro';
import Icon from '../shared/ui/Icon.astro';
import Evaluation from './Evaluation.astro';
const { decide } = home;
const amara = byId('amara');
const ines = byId('ines');
const kenji = byId('kenji');
const cards = [amara, ines, kenji];
const slotH = 'h-[8rem]';
---
<Section id="decide" labelledby="decide-title" tone="white">
  <div data-decide class="home-decide">
    <div data-reveal class="mx-auto max-w-[44rem] text-center">
      <h2 data-speed="0.1" id="decide-title" class="m-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]">{decide.title}</h2>
      <p class="m-0 mx-auto mt-5 max-w-[34rem] text-lg leading-relaxed text-text-secondary">{decide.sub}</p>
    </div>

    <Figure caption={decide.caption} class="mt-14">
      <div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
        <div data-board class="relative w-full rounded-lg border border-border-secondary bg-white p-4 font-ui text-text-primary shadow-md">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <p class="m-0 text-sm font-semibold">{role.title}</p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div data-col="from" class="rounded-md bg-bg-tertiary p-2">
              <h3 class="m-0 mb-2 flex items-center gap-1.5 px-1 text-xs font-semibold text-text-secondary">
                <span class:list={['size-1.5 rounded-full', toneDot[stageTone.Completed]]} aria-hidden="true"></span>{decide.from}
                <span data-count="from" class="ml-auto font-medium tabular-nums text-text-tertiary">2</span>
              </h3>
              <ul class="m-0 flex list-none flex-col gap-2 p-0">
                <li data-slot="home" class:list={['relative', slotH]}>
                  <span data-ghost aria-hidden="true" class="absolute inset-0 rounded-md border border-dashed border-border-primary opacity-0"></span>
                  <article
                    data-card="amara"
                    data-evidence-for="amara"
                   
                    tabindex="0"
                    aria-label={`${amara.name}, Job Fit ${amara.fit}%`}
                    aria-describedby="decide-help"
                    class="absolute inset-0 flex select-none flex-col rounded-md border border-border-secondary bg-white p-2.5 shadow-md outline-offset-2 transition-[border-color] duration-[var(--duration-fast)] hover:border-primary-300 data-[landed=true]:border-primary"
                  >
                    <div class="flex items-center gap-2"><Avatar initials={amara.initials} size="xs" lead /><span class="min-w-0 truncate text-xs font-semibold">{amara.name}</span></div>
                    <p class="m-0 mt-1.5 text-[0.6875rem] text-text-tertiary">Job Fit {amara.fit}%</p>
                    <p data-stamp class="m-0 mt-auto flex items-center gap-1.5 border-t border-border-secondary pt-2 text-[0.6875rem] font-medium text-text-secondary opacity-0">
                      <span class="grid size-4 place-items-center rounded-full bg-primary text-white"><Icon name="check" size={10} /></span>{decide.stamp}
                    </p>
                  </article>
                </li>
                <li class:list={[slotH]}>
                  <article data-evidence-for="ines" tabindex="0" aria-label={`${ines.name}, Job Fit ${ines.fit}%`} class="flex h-full flex-col rounded-md border border-border-secondary bg-white p-2.5 shadow-xs transition-[border-color,transform] duration-[var(--duration-base)] ease-[var(--ease-out-quart)] hover:border-primary-300">
                    <div class="flex items-center gap-2"><Avatar initials={ines.initials} size="xs" /><span class="min-w-0 truncate text-xs font-semibold">{ines.name}</span></div>
                    <p class="m-0 mt-1.5 text-[0.6875rem] text-text-tertiary">Job Fit {ines.fit}%</p>
                  </article>
                </li>
              </ul>
            </div>
            <div data-col="to" class="rounded-md bg-bg-tertiary p-2">
              <h3 class="m-0 mb-2 flex items-center gap-1.5 px-1 text-xs font-semibold text-text-secondary">
                <span class:list={['size-1.5 rounded-full', toneDot[stageTone['HR Round']]]} aria-hidden="true"></span>{decide.to}
                <span data-count="to" class="ml-auto font-medium tabular-nums text-text-tertiary">1</span>
              </h3>
              <ul class="m-0 flex list-none flex-col gap-2 p-0">
                <li data-slot="away" class:list={['relative', slotH]}>
                  <span data-drop class="absolute inset-0 grid place-items-center rounded-md border border-dashed border-border-primary text-[0.6875rem] text-text-tertiary transition-[background-color] duration-[var(--duration-fast)] data-[hot=true]:bg-primary-50" aria-hidden="true">{decide.drop}</span>
                </li>
                <li class:list={[slotH]}>
                  <article data-evidence-for="kenji" tabindex="0" aria-label={`${kenji.name}, Job Fit ${kenji.fit}%`} class="flex h-full flex-col rounded-md border border-border-secondary bg-white p-2.5 shadow-xs transition-[border-color] duration-[var(--duration-base)] hover:border-primary-300">
                    <div class="flex items-center gap-2"><Avatar initials={kenji.initials} size="xs" /><span class="min-w-0 truncate text-xs font-semibold">{kenji.name}</span></div>
                    <p class="m-0 mt-1.5 text-[0.6875rem] text-text-tertiary">Job Fit {kenji.fit}%</p>
                  </article>
                </li>
              </ul>
            </div>
          </div>
          <p id="decide-help" class="sr-only">{decide.dragHelp}</p>
          <p data-decide-status role="status" class="sr-only"></p>
        </div>

        <div data-evidence-wrap class="relative">
          {cards.map((c, i) => {
            const e = decide.evidence[c.id as 'amara' | 'ines' | 'kenji'];
            return (
              <div data-evidence={c.id} data-active={i === 0 ? 'true' : 'false'}>
                <Evaluation name={c.name} jobFit={e.jobFit} score={e.score} swot={e.swot} />
              </div>
            );
          })}
          <p class="m-0 mt-3 text-xs text-text-tertiary">{decide.note}</p>
        </div>
      </div>
    </Figure>
  </div>
</Section>
