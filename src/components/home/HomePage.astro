---
/**
 * The home page, shared by `/` and the preview route so there is one copy of the page body.
 * Copy still comes from src/content/home.ts; a later step wires it to Strapi's `home` entry.
 */
import Base from '../../layouts/Base.astro';
import { home } from '../../content/home';
import type { SeoMeta } from '../../lib/schemas';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import SocialProof from './SocialProof.astro';
import Results from './Results.astro';
import ScreeningLab from './labs/ScreeningLab.astro';
import InterviewLab from './labs/InterviewLab.astro';
import Decide from './Decide.astro';
import How from './How.astro';
import Platform from './Platform.astro';
import Audience from './Audience.astro';
import Faq from './Faq.astro';
import Close from './Close.astro';
import Footer from './Footer.astro';
import './home.css';

interface Props { seo: SeoMeta; forceNoindex?: boolean }
const { seo, forceNoindex = false } = Astro.props;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: home.faq.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
<Base {seo} {forceNoindex} fluid>
  <script is:inline>
    document.documentElement.classList.add('js');
    setTimeout(function () { document.documentElement.classList.add('js-fail'); }, 4000);
  </script>
  <div class="home bg-white text-text-primary">
    <Nav />
    <main>
      <Hero />
      <SocialProof />
      <Results />
      <ScreeningLab tone="white" />
      <InterviewLab tone="plate" />
      <Decide />
      <How />
      <Platform />
      <Audience />
      <Faq />
      <Close />
    </main>
    <Footer />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { initHome } from './motion';
  initHome();
</script>
