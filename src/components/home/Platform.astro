---
import { home } from '../../content/home';
import { slots, hiringTrend, embed } from '../../data/demo';
import Section from './Section.astro';
import DashboardOverview from '../shared/ui/DashboardOverview.astro';
import JobsOverview from '../shared/ui/JobsOverview.astro';
import CandidateProfile from '../shared/ui/CandidateProfile.astro';
import PipelineBoard from '../shared/ui/PipelineBoard.astro';
import InterviewSchedule from '../shared/ui/InterviewSchedule.astro';
import CareerSetup from '../shared/ui/CareerSetup.astro';
import AnalyticsView from '../shared/ui/AnalyticsView.astro';
import Chip from '../shared/ui/Chip.astro';
import Icon from '../shared/ui/Icon.astro';
const { platform } = home;
const t = platform.tiles;
const tile = 'group relative flex min-w-0 flex-col bg-white p-6 sm:p-8';
const tileTitle = 'm-0 text-[1.0625rem] font-semibold tracking-[-0.01em]';
const tileLine = 'm-0 mt-1.5 max-w-[34rem] text-[0.9375rem] leading-snug text-text-secondary';
const plate = 'relative m-0 mt-6 flex flex-1 items-center justify-center rounded-lg bg-bg-tertiary p-3 sm:p-5';
const btn = 'inline-flex h-9 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-border-primary bg-white px-3 text-[0.8125rem] font-medium text-text-secondary shadow-xs transition-[background-color] duration-[var(--duration-fast)] hover:bg-bg';
const selectedTime = slots.selected.time;
const selIdx = slots.times.indexOf(selectedTime);
const trendTabs = hiringTrend.tabs;
const trendFirst = platform.trend[trendTabs[0] ?? 'Applications'] ?? [];
const trendJson = JSON.stringify({ tabs: trendTabs, data: platform.trend, weeks: hiringTrend.weeks.map((w) => w.label) });
---
---
<Section id="platform" labelledby="platform-title" tone="white" innerClass="px-0! sm:px-0! md:px-0!">
  <div data-platform class="home-platform">
    <div class="grid items-start gap-8 px-5 sm:px-8 md:px-12 lg:grid-cols-12 lg:gap-12" data-reveal>
      <div class="rounded-lg border border-border-secondary bg-bg p-5 lg:col-span-4 lg:mt-3">
        <p class="m-0 text-[0.9375rem] leading-relaxed text-text-secondary">{platform.intro}</p>
      </div>
      <h2 data-speed="0.1" id="platform-title" class="m-0 max-w-[36rem] text-[clamp(2rem,1.2rem+2.8vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.03em] lg:col-span-8">{platform.title}</h2>
    </div>

    <div data-bento class="mt-14 grid gap-px border-y border-border-secondary bg-border-secondary md:grid-cols-2 xl:grid-cols-6">
      <article data-tile="dashboard" aria-labelledby="t-dashboard" class:list={[tile, 'md:col-span-2 xl:col-span-6']}>
        <h3 id="t-dashboard" class={tileTitle}>{t.dashboard.title}</h3>
        <p class={tileLine}>{t.dashboard.line}</p>
        <figure class={plate}>
          <DashboardOverview />
          <figcaption class="sr-only">Novara dashboard with active jobs, things to do, a jobs overview chart and recent activity. Hover or focus a bar for its stage counts.</figcaption>
        </figure>
      </article>

      <article data-tile="jobs" aria-labelledby="t-jobs" class:list={[tile, 'xl:col-span-3']}>
        <h3 id="t-jobs" class={tileTitle}>{t.jobs.title}</h3>
        <p class={tileLine}>{t.jobs.line}</p>
        <figure class={plate}>
          <JobsOverview />
          <figcaption class="sr-only">Jobs list with applicants, shortlisted candidates, source, hiring summary and status.</figcaption>
        </figure>
      </article>

      <article data-tile="candidate" aria-labelledby="t-candidate" class:list={[tile, 'xl:col-span-3']}>
        <h3 id="t-candidate" class={tileTitle}>{t.candidate.title}</h3>
        <p class={tileLine}>{t.candidate.line}</p>
        <figure class={plate}>
          <CandidateProfile />
          <figcaption class="sr-only">Candidate profile with job history. Each application shows a Job Fit Score and an AI Interview Score as percentages.</figcaption>
        </figure>
      </article>

      <article data-tile="pipeline" aria-labelledby="t-pipeline" class:list={[tile, 'md:col-span-2 xl:col-span-4']}>
        <h3 id="t-pipeline" class={tileTitle}>{t.pipeline.title}</h3>
        <p class={tileLine}>{t.pipeline.line}</p>
        <figure class={plate}>
          <div class="w-full"><PipelineBoard class="max-w-none!" /></div>
          <figcaption class="sr-only">Pipeline board with stage columns. Cards lift when you hover or focus them.</figcaption>
        </figure>
      </article>

      <article data-tile="scheduling" aria-labelledby="t-sched" class:list={[tile, 'md:col-span-2 xl:col-span-2']}>
        <h3 id="t-sched" class={tileTitle}>{t.scheduling.title}</h3>
        <p class={tileLine}>{t.scheduling.line}</p>
        <figure class={plate}>
          <div data-sched data-day="Wed 21 Oct" data-toast-text={slots.toast} class="relative w-full max-w-[20rem] rounded-lg border border-border-secondary bg-white p-3.5 font-ui text-text-primary shadow-xs">
            <p class="m-0 text-xs font-semibold">Wed 21 Oct</p>
            <div data-slot-grid role="radiogroup" aria-label="Interview slots" data-cursor="Try it" class="relative mt-2.5 grid grid-cols-2 gap-2">
              <span
                data-pick
                aria-hidden="true"
                class="absolute h-9 rounded-md bg-primary"
                style={`width:calc((100% - 0.5rem) / 2);left:calc(${selIdx % 2} * ((100% - 0.5rem) / 2 + 0.5rem));top:calc(${Math.floor(selIdx / 2)} * 2.75rem)`}
              ></span>
              {slots.times.map((time) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={time === selectedTime ? 'true' : 'false'}
                  data-time={time}
                  class="relative z-10 h-9 rounded-md border border-border-secondary text-center text-[0.8125rem] font-medium tabular-nums text-text-secondary transition-[color,border-color] duration-[var(--duration-fast)] hover:border-primary-300 aria-checked:border-primary aria-checked:text-white"
                >{time}</button>
              ))}
            </div>
            <ul class="m-0 mt-3 flex list-none flex-col gap-1.5 border-t border-border-secondary p-0 pt-3 text-xs">
              <li class="flex items-center justify-between gap-2"><span data-booked class="tabular-nums text-text-primary">Wed 21 Oct, {selectedTime}</span><Chip tone="success">Booked</Chip></li>
              <li class="flex items-center justify-between gap-2"><span data-previous class="tabular-nums text-text-tertiary">Tue 20 Oct, 09:30</span><Chip tone="gray">Previous booking</Chip></li>
            </ul>
          </div>
          <p data-toast role="status" class="pointer-events-none absolute inset-x-5 bottom-5 m-0 rounded-md border border-border-secondary bg-white px-3 py-2 font-ui text-xs font-medium text-text-primary opacity-0 shadow-lg"></p>
          <figcaption class="sr-only">Slot picker. Pick a time to book it. The earlier booking stays on record.</figcaption>
        </figure>
      </article>

      <article data-tile="interviews" aria-labelledby="t-interviews" class:list={[tile, 'xl:col-span-3']}>
        <h3 id="t-interviews" class={tileTitle}>{t.interviews.title}</h3>
        <p class={tileLine}>{t.interviews.line}</p>
        <figure class={plate}>
          <InterviewSchedule />
          <figcaption class="sr-only">Interview dashboard with completed, rescheduled, booked and expired counts and the scheduled interviews table.</figcaption>
        </figure>
      </article>

      <article data-tile="career" aria-labelledby="t-career" class:list={[tile, 'xl:col-span-3']}>
        <h3 id="t-career" class={tileTitle}>{t.career.title}</h3>
        <p class={tileLine}>{t.career.line}</p>
        <figure class:list={[plate, 'flex-col gap-3!']}>
          <div class="w-full"><CareerSetup /></div>
          <div class="self-start">
            <button type="button" data-copy data-embed={JSON.stringify(embed)} data-cursor="Copy" class={btn}>
              <Icon name="copy" size={14} /><span data-copy-label>{platform.copyEmbed}</span>
            </button>
          </div>
          <p data-copy-status role="status" class="sr-only"></p>
          <figcaption class="sr-only">Career page setup with a live preview. Choose a layout and theme, and copy the embed code.</figcaption>
        </figure>
      </article>

      <article data-tile="analytics" aria-labelledby="t-analytics" class:list={[tile, 'md:col-span-2 xl:col-span-6']}>
        <h3 id="t-analytics" class={tileTitle}>{t.analytics.title}</h3>
        <p class={tileLine}>{t.analytics.line}</p>
        <figure class={plate}>
          <AnalyticsView trendJson={trendJson} first={trendFirst} readout={platform.hoverBar} />
          <figcaption class="sr-only">Analytics with a weekly hiring trend. Switch the view with the tabs and hover a bar for its value.</figcaption>
        </figure>
      </article>
    </div>
    <p class="m-0 mt-4 px-5 text-xs text-text-tertiary sm:px-8 md:px-12">{platform.note}</p>
  </div>
</Section>
