---
import { home } from '../../content/home';
import { byId, candidates, recruiter, role } from '../../data/demo';
import Section from './Section.astro';
import Avatar from '../shared/ui/Avatar.astro';
import ApplicantList from '../shared/ui/ApplicantList.astro';
import CareerPage from '../shared/ui/CareerPage.astro';
import Chip from '../shared/ui/Chip.astro';
import InterviewScore from '../shared/ui/InterviewScore.astro';
import JobDraft from '../shared/ui/JobDraft.astro';
import JobFitCard from '../shared/ui/JobFitCard.astro';
import SlotPicker from '../shared/ui/SlotPicker.astro';
const { how } = home;
const amara = byId('amara');
const ranked = [...candidates].sort((a, b) => b.fit - a.fit).filter((c) => ['amara', 'ines', 'leo', 'nadia'].includes(c.id));
const applied = [byId('leo'), byId('marcus'), byId('nadia')];
const card = 'w-full max-w-[26rem] rounded-lg border border-border-secondary bg-bg-secondary p-4 font-ui text-text-primary shadow-md';
const row = 'flex items-center gap-2 rounded-md border border-border-secondary bg-white p-2.5';
---
<Section id="how" labelledby="how-title" tone="plate">
  <div data-how class="home-how">
    <div data-how-pin class="home-how-pin">
      <div data-reveal>
        <h2 id="how-title" class="m-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]">{how.title}</h2>
      </div>
      <div data-how-progress hidden class="relative mt-8 h-px w-full bg-border-secondary" aria-hidden="true">
        <div data-how-line class="h-full origin-left bg-border-primary"></div>
        {how.steps.map((_, i) => <i data-how-dot class="absolute top-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border-primary bg-white" style={`left:${(i / (how.steps.length - 1)) * 100}%`}></i>)}
      </div>
      <div data-how-viewport class="home-how-viewport mt-10">
        <ol data-how-track class="home-how-track m-0 grid list-none gap-14 p-0">
          {how.steps.map((s, i) => (
            <li data-step class="grid items-center gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] md:gap-12">
              <div>
                <span data-num class="grid size-7 place-items-center rounded-full border border-border-primary bg-white text-xs font-medium tabular-nums text-text-secondary transition-[background-color,color,border-color] duration-[var(--duration-base)]">{i + 1}</span>
                <h3 class="m-0 mt-5 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-semibold leading-tight tracking-[-0.02em]"><button type="button" data-step-btn class="cursor-pointer rounded-sm p-0 text-left font-[inherit] text-inherit">{s.title}</button></h3>
                <p class="m-0 mt-2 max-w-[22rem] text-[0.9375rem] leading-snug text-text-secondary">{s.text}</p>
              </div>
              <div data-vignette={i} data-fit class="home-fit" aria-hidden="true">
                <div data-fit-inner class="home-fit-inner">
                {i === 0 && <JobDraft />}
                {i === 1 && <CareerPage />}
                {i === 2 && (
                  <div class={card}>
                    <div class="flex items-center gap-2 rounded-md bg-bg-tertiary px-3 py-2">
                      <span class="flex-1 truncate text-[0.8125rem] font-semibold">{role.title}</span>
                      <span data-v="apply" class="shrink-0 rounded-sm bg-primary px-2 py-1 text-[0.6875rem] font-medium text-white">Apply</span>
                    </div>
                    <p class="m-0 mt-4 text-xs font-semibold text-text-tertiary">New applications</p>
                    <ul class="m-0 mt-2 flex list-none flex-col gap-2 p-0">
                      {applied.map((c) => (
                        <li data-v="applied" class={row}>
                          <Avatar initials={c.initials} size="xs" /><span class="min-w-0 flex-1 truncate text-[0.8125rem] font-medium">{c.name}</span>
                          <Chip tone="gray">Applied</Chip>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {i === 3 && <JobFitCard variant="detail" />}
                {i === 4 && <ApplicantList rows={ranked} />}
                {i === 5 && <SlotPicker />}
                {i === 6 && <InterviewScore />}
                {i === 7 && (
                  <div class={`${card} max-w-[30rem]`}>
                    <div class="grid grid-cols-2 gap-3">
                      <div data-v="from" class="rounded-md bg-bg-tertiary p-2">
                        <p class="m-0 mb-2 px-1 text-xs font-semibold text-text-secondary">{home.decide.from}</p>
                        <div class="h-[5.5rem] rounded-md border border-dashed border-border-primary"></div>
                      </div>
                      <div data-v="to" class="rounded-md bg-bg-tertiary p-2">
                        <p class="m-0 mb-2 px-1 text-xs font-semibold text-text-secondary">{home.decide.to}</p>
                        <div class="relative h-[5.5rem]">
                          <span class="absolute inset-0 rounded-md border border-dashed border-border-primary"></span>
                          <div data-v="card" class="absolute inset-0 flex flex-col justify-between rounded-md border border-primary bg-white p-2.5 shadow-md">
                            <div class="flex items-center gap-2"><Avatar initials={amara.initials} size="xs" lead /><span class="min-w-0 truncate text-xs font-semibold">{amara.name}</span></div>
                            <p data-v="stamp" class="m-0 flex items-center gap-1.5 text-[0.6875rem] font-medium text-text-secondary"><Avatar initials={recruiter.initials} size="xs" />Moved by {recruiter.first}</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                {i === 8 && (
                  <div class={card}>
                    <div class="flex items-center gap-3">
                      <Avatar initials={amara.initials} lead />
                      <div class="min-w-0 flex-1">
                        <p class="m-0 truncate text-sm font-semibold">{amara.name}</p>
                        <p class="m-0 truncate text-xs text-text-tertiary">{role.title}</p>
                      </div>
                      <span class="grid justify-items-end">
                        <span data-v="stage-from" class="col-start-1 row-start-1"><Chip tone="primary">HR Round</Chip></span>
                        <span data-v="stage-to" class="col-start-1 row-start-1"><Chip tone="success">Offered</Chip></span>
                      </span>
                    </div>
                    <p class="m-0 mt-5 text-xs font-semibold text-text-tertiary">Make an offer?</p>
                    <div class="mt-2 flex gap-2 text-[0.8125rem] font-medium">
                      <span data-v="offer" class="flex-1 rounded-md bg-primary px-3 py-2 text-center text-white shadow-xs">Offer</span>
                      <span class="flex-1 rounded-md border border-border-primary px-3 py-2 text-center text-text-secondary shadow-xs">Reject</span>
                    </div>
                    <p data-v="stamp" class="m-0 mt-4 flex items-center gap-1.5 rounded-md bg-bg-tertiary px-3 py-2 text-xs text-text-secondary"><Avatar initials={recruiter.initials} size="xs" />Moved to Offered by {recruiter.first}</p>
                  </div>
                )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Section>
