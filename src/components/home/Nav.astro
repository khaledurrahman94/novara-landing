---
import { home } from '../../content/home';
import Button from './Button.astro';
const { nav } = home;
---
<header data-nav data-scrolled="false" class="sticky top-0 z-50 border-b border-transparent bg-transparent transition-[background-color,border-color] duration-[var(--duration-slow)] ease-[var(--ease-out-quart)] data-[scrolled=true]:border-border-secondary data-[scrolled=true]:bg-white">
  <div class="mx-auto flex h-16 w-full max-w-[75rem] items-center justify-between gap-6 border-x border-border-secondary px-5 sm:px-8 md:px-12">
    <a href="/" class="shrink-0 rounded-sm" aria-label={nav.home}>
      <img src="/brand/novara-full.svg" width="143" height="41" alt="Novara" class="block h-7 w-auto" />
    </a>
    <nav aria-label={nav.label} class="hidden md:block">
      <ul class="m-0 flex list-none items-center gap-6 p-0 lg:gap-8">
        {nav.links.map((a) => (
          <li><a href={a.href} class="text-sm font-medium text-text-tertiary no-underline transition-colors duration-[var(--duration-fast)] hover:text-text-primary">{a.label}</a></li>
        ))}
      </ul>
    </nav>
    <Button href="#demo-close" data-home-cta data-magnetic>{nav.cta}</Button>
  </div>
</header>
