---
import { home } from '../../content/home';
import Button from './Button.astro';
import { HOME_PATH, homeHref } from '../../lib/home-path';
interface Props {
  /** Where the CTA goes. Other pages pass `HOME_DEMO_HREF` so it lands on the home form. */
  ctaHref?: string;
  /** Opaque bar from the start. The home page's scroll script does this on scroll; other pages have no script. */
  solid?: boolean;
}
const { ctaHref = '#demo-close', solid = false } = Astro.props;
const { nav } = home;
/** Only links whose page exists (`live` in home.ts). */
const links = nav.links.filter((l) => l.live);
---
<header data-nav data-scrolled={solid ? 'true' : 'false'} class="sticky top-0 z-50 border-b border-transparent bg-transparent transition-[background-color,border-color] duration-[var(--duration-slow)] ease-[var(--ease-out-quart)] data-[scrolled=true]:border-border-secondary data-[scrolled=true]:bg-white">
  <div class="mx-auto flex h-16 w-full max-w-[75rem] items-center justify-between gap-6 border-x border-border-secondary px-5 sm:px-8 md:px-12">
    <a href={HOME_PATH} class="shrink-0 rounded-sm" aria-label={nav.home}>
      <img src="/brand/novara-full.svg" width="143" height="41" alt="Novara" class="block h-7 w-auto" />
    </a>
    {links.length > 0 && (
      <nav aria-label={nav.label} class="hidden md:block">
        <ul class="m-0 flex list-none items-center gap-6 p-0 lg:gap-8">
          {links.map((a) => (
            <li><a href={homeHref(a.href)} class="text-sm font-medium text-text-tertiary no-underline transition-colors duration-[var(--duration-fast)] hover:text-text-primary">{a.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <Button href={nav.getStarted.href} variant="secondary" class="hidden sm:inline-flex">{nav.getStarted.label}</Button>
      <Button href={ctaHref} data-home-cta>{nav.cta}</Button>
    </div>
  </div>
</header>
