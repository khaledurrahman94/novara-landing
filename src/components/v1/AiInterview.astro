---
import { v1 } from '../../content/v1';
import SectionHead from './SectionHead.astro';
import Plate from '../shared/ui/Plate.astro';
import InterviewFrame from '../shared/ui/InterviewFrame.astro';
import IntegrityPanel from '../shared/ui/IntegrityPanel.astro';
import InterviewScore from '../shared/ui/InterviewScore.astro';
const { interview: copy } = v1;
---
<section id="interview" data-interview aria-labelledby="interview-title" class="scroll-mt-16 bg-bg-secondary py-section">
  <div class="mx-auto w-full max-w-[var(--v1-max,84rem)] px-gutter">
    <SectionHead id="interview-title" title={copy.title} line={copy.line} />

    <Plate caption={copy.figure} parallax class="mt-14 lg:mt-16" innerClass="block">
      <div class="grid gap-4 sm:gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <div data-int-frame class="min-w-0"><InterviewFrame fill /></div>
        <div data-int-integrity class="min-w-0"><IntegrityPanel class="max-w-none" /></div>
        <div data-int-score class="min-w-0 lg:col-span-2"><InterviewScore wide /></div>
      </div>
    </Plate>
  </div>
</section>
