---
import { v1 } from '../../content/v1';
import { pipelineStatus, recruiter, role } from '../../data/demo';
import Button from './Button.astro';
import JobFitCard from '../shared/ui/JobFitCard.astro';
import InterviewFrame from '../shared/ui/InterviewFrame.astro';
import Avatar from '../shared/ui/Avatar.astro';
import Chip from '../shared/ui/Chip.astro';
import Icon from '../shared/ui/Icon.astro';
const { hero } = v1;
---
<section id="top" data-hero aria-labelledby="hero-title" class="relative overflow-hidden bg-bg">
  <div class="mx-auto grid w-full max-w-[var(--v1-max,84rem)] gap-16 px-gutter pb-section pt-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-center lg:gap-14 lg:pt-20">
    <div class="min-w-0">
      <h1 id="hero-title" class="m-0 font-display text-[clamp(2.25rem,9.4vw,3.5rem)] font-medium leading-[1.12] tracking-[-0.03em] text-text-primary lg:text-[min(4vw,3.2rem)] lg:whitespace-nowrap text-balance">
        {hero.lines.map((l, i) => (
          <span data-hero-line class:list={['block', i === 2 && 'text-primary']}>{l}</span>
        ))}
      </h1>
      <p data-hero-rise class="mb-0 mt-8 max-w-[34rem] text-lg leading-relaxed text-text-tertiary">{hero.sub}</p>
      <div data-hero-rise class="mt-9 flex flex-wrap gap-3">
        <Button href="#demo" arrow>{hero.primary}</Button>
        <Button href="#how" variant="secondary">{hero.secondary}</Button>
      </div>

      <div data-hero-rise class="mt-14">
        <dl class="m-0 flex flex-wrap gap-x-10 gap-y-6 sm:gap-x-14">
          {hero.stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="text-base text-text-tertiary">{s.label}</dt>
              <dd class="m-0 font-display text-4xl font-semibold tabular-nums leading-none tracking-[-0.02em] text-text-primary sm:text-5xl" data-anim="count" data-count={s.value} data-suffix={s.suffix || undefined}>{s.display}</dd>
            </div>
          ))}
        </dl>
        <p class="mb-0 mt-5 text-sm text-text-tertiary">{hero.caption}</p>
      </div>
    </div>

    <div class="min-w-0 lg:justify-self-end">
      <div
        role="group"
        aria-label={hero.compositionLabel}
        class="relative mx-auto h-[29.375rem] w-[30rem] [zoom:0.64] min-[390px]:[zoom:0.7] min-[480px]:[zoom:0.9] min-[560px]:[zoom:1] lg:mx-0 lg:[zoom:0.78] xl:[zoom:1]"
      >
        <div data-scroll="24" class="absolute right-0 top-0 w-[15rem]">
          <div data-px="0.45"><div data-enter="1"><JobFitCard variant="ring" /></div></div>
        </div>
        <div data-scroll="-36" class="absolute left-0 top-[9.375rem] w-[17rem]">
          <div data-px="0.75"><div data-enter="2"><InterviewFrame size="sm" /></div></div>
        </div>
        <div data-scroll="-84" class="absolute left-0 top-0 w-[14rem]">
          <div data-px="1"><div data-enter="3">
            <div class="flex items-center gap-3 rounded-lg border border-border-secondary bg-bg-secondary px-3 py-2.5 font-ui shadow-lg">
              <span class="grid size-9 shrink-0 place-items-center rounded-md bg-primary-50 text-primary"><Icon name="briefcase" size={18} /></span>
              <span class="min-w-0">
                <span class="block text-[0.6875rem] text-text-tertiary">{hero.chips.job}</span>
                <span class="block truncate text-[0.8125rem] font-semibold text-text-primary">{role.short}</span>
                <Chip tone="success" class="mt-1">{hero.chips.jobValue}</Chip>
              </span>
            </div>
          </div></div>
        </div>
        <div data-scroll="-84" class="absolute bottom-0 right-0 w-[19.875rem]">
          <div data-px="1"><div data-enter="3">
            <div class="flex items-center gap-3 rounded-lg border border-border-secondary bg-bg-secondary px-3 py-2.5 font-ui shadow-lg">
              <Avatar initials={recruiter.initials} size="md" />
              <span class="min-w-0">
                <span class="block text-[0.6875rem] text-text-tertiary">{hero.chips.pipeline}</span>
                <span class="block text-[0.8125rem] font-semibold text-text-primary">{pipelineStatus}</span>
              </span>
            </div>
          </div></div>
        </div>
      </div>
    </div>
  </div>
</section>
