---
import { v1 } from '../../content/v1';
import Button from './Button.astro';
const { header } = v1;
---
<header data-header class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-[var(--duration-slow)] ease-[var(--ease-out-quart)] data-[scrolled=true]:border-border-secondary data-[scrolled=true]:bg-bg-secondary">
  <div class="mx-auto flex h-16 w-full max-w-[84rem] items-center justify-between gap-6 px-gutter">
    <a href="#top" class="shrink-0" aria-label="Novara, back to top">
      <img src="/brand/novara-full.svg" width="143" height="41" alt="Novara" class="h-8 w-auto" />
    </a>
    <nav aria-label={header.nav} class="hidden md:block">
      <ul class="m-0 flex list-none items-center gap-8 p-0">
        {header.anchors.map((a) => (
          <li>
            <a href={a.href} class="text-[15px] font-medium text-text-tertiary no-underline transition-colors duration-[var(--duration-fast)] hover:text-text-primary">{a.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href="#demo" class="px-4! py-2! text-[15px]!">{header.cta}</Button>
  </div>
</header>
