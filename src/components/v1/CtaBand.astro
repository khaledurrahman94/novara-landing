---
import { v1 } from '../../content/v1';
import Icon from '../shared/ui/Icon.astro';
/** The one place the brand gradient appears. */
interface Props { action?: string }
// TODO: point `action` at the demo-request endpoint once one exists. Until then the form validates and shows a success state client-side only.
const { action = '#demo' } = Astro.props;
const { cta } = v1;
---
<section id="demo" data-cta aria-labelledby="cta-title" class="scroll-mt-16 bg-brand-gradient py-section text-white">
  <div class="mx-auto grid w-full max-w-[84rem] gap-10 px-gutter lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
    <div class="min-w-0">
      <h2 id="cta-title" class="m-0 max-w-[16ch] text-balance font-display text-display-lg font-semibold leading-[1.04] tracking-[-0.03em]">{cta.title}</h2>
      <p class="m-0 mt-6 max-w-[30rem] text-xl font-bold leading-snug">{cta.line}</p>
    </div>

    <div class="min-w-0">
      <form
        data-cta-form
        action={action}
        method="post"
        class="flex flex-col gap-3 sm:flex-row"
        data-msg-empty={cta.errorEmpty}
        data-msg-invalid={cta.errorInvalid}
      >
        <label for="demo-email" class="sr-only">{cta.emailLabel}</label>
        <input
          id="demo-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder={cta.placeholder}
          class="min-w-0 flex-1 rounded-md border border-transparent bg-white px-4 py-3 text-base text-text-primary shadow-md outline-none placeholder:text-text-placeholder focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary-700 aria-[invalid=true]:border-warning"
        />
        <button
          type="submit"
          data-submit
          class="rounded-md bg-primary-950 px-5 py-3 text-base font-semibold text-white shadow-md transition-[background-color,transform] duration-[var(--duration-fast)] ease-[var(--ease-out-quart)] hover:bg-gray-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white active:scale-[0.98] disabled:opacity-70"
        >{cta.submit}</button>
      </form>
      <p data-form-error role="alert" hidden class="mb-0 mt-3 inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-medium text-text-primary shadow-md">
        <Icon name="alert" size={16} class="text-warning" /><span data-form-error-text></span>
      </p>
      <div data-form-success role="status" hidden class="rounded-lg bg-white p-5 text-text-primary shadow-lg">
        <p class="m-0 flex items-center gap-2 text-lg font-semibold"><span class="grid size-6 place-items-center rounded-full bg-success text-white"><Icon name="check" size={14} /></span>{cta.successTitle}</p>
        <p class="m-0 mt-1.5 text-base text-text-tertiary">{cta.successBody}</p>
      </div>
    </div>
  </div>
</section>
