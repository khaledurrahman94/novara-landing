---
import { v1 } from '../../content/v1';
const { footer, header } = v1;
---
<footer data-footer class="relative overflow-hidden bg-bg-secondary">
  <div class="mx-auto w-full max-w-[84rem] px-gutter pt-20 lg:pt-24">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <img src="/brand/novara-full.svg" width="143" height="41" alt="Novara" class="h-9 w-auto" />
        <p class="m-0 mt-5 max-w-[26rem] text-lg leading-snug text-text-tertiary">{footer.line}</p>
      </div>
      <div class="grid gap-8 sm:grid-cols-2">
        <nav aria-label={footer.navLabel}>
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {header.anchors.map((a) => (
              <li><a href={a.href} class="text-base text-text-secondary no-underline transition-colors duration-[var(--duration-fast)] hover:text-primary">{a.label}</a></li>
            ))}
          </ul>
        </nav>
        <p class="m-0 text-base text-text-secondary">
          <a href={footer.productHref} rel="noopener" class="underline decoration-border-primary underline-offset-4 transition-colors duration-[var(--duration-fast)] hover:text-primary hover:decoration-primary">{footer.product}</a>
        </p>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-border-secondary pt-6 text-sm text-text-tertiary sm:flex-row sm:justify-between sm:gap-10">
      <p class="m-0 shrink-0">{footer.copyright}</p>
      <p class="m-0 max-w-[40rem] sm:text-right">{footer.footnote}</p>
    </div>
  </div>

  <div aria-hidden="true" class="pointer-events-none select-none overflow-hidden pt-10 [mask-image:linear-gradient(to_bottom,black_15%,transparent_92%)]">
    <p data-wordmark class="m-0 text-center font-display text-[clamp(6rem,25vw,24rem)] font-bold leading-[0.8] tracking-[-0.05em] text-primary-200">Novara</p>
  </div>
</footer>
