---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'white';
  size?: 'md' | 'lg';
  class?: string | undefined;
}
const { href, variant = 'primary', size = 'lg', class: cls } = Astro.props;
const variants = {
  primary: 'bg-primary text-white hover:bg-primary-600',
  secondary: 'border border-border-primary bg-white text-text-secondary hover:bg-bg',
  white: 'bg-white font-semibold text-primary-700 hover:bg-primary-50 focus-visible:outline-white',
};
const sizes = {
  md: 'h-10 px-4 text-sm',
  lg: 'h-11 px-5 text-[0.9375rem]',
};
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium no-underline shadow-xs',
    'transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-quart)]',
    variants[variant],
    sizes[size],
    cls,
  ]}
><slot /></a>
