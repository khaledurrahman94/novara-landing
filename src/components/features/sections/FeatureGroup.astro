---
import type { FeatureGroupContent } from '../../../content/feature-pages/types';
import FeatureBand from '../ui/FeatureBand.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import FeatureRow from './FeatureRow.astro';

interface Props {
  group: FeatureGroupContent;
  tone: 'white' | 'plate';
}
const { group, tone } = Astro.props;
const headingId = `${group.id}-title`;
const plateTone = tone === 'plate' ? 'white' : 'plate';
---
<FeatureBand id={group.id} {tone} labelledby={group.title ? headingId : undefined} class="flex flex-col gap-16 md:gap-24">
  {group.title && <SectionHeading id={headingId} title={group.title} intro={group.intro} />}
  {group.rows.map((row) => <FeatureRow {row} level={group.title ? 3 : 2} {plateTone} />)}
</FeatureBand>
