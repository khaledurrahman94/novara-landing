---
import type { FeaturePageContent } from '../../../content/feature-pages/types';
import CtaGroup from '../ui/CtaGroup.astro';
import ShotPlate from '../ui/ShotPlate.astro';
import { type } from '../ui/typography';

interface Props {
  hero: FeaturePageContent['hero'];
}
const { hero } = Astro.props;
---
<section aria-labelledby="feature-title" class="overflow-hidden bg-white">
  <div class="mx-auto grid w-full max-w-[75rem] items-center gap-10 border-x border-border-secondary px-5 py-16 sm:px-8 md:px-12 md:py-24 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:py-28">
    <div class="flex flex-col gap-6 max-lg:mx-auto max-lg:max-w-[38rem] max-lg:items-center max-lg:text-center max-sm:items-start max-sm:text-left">
      <h1 id="feature-title" class={type.h1}>{hero.title}</h1>
      <p class={type.lead}>{hero.text}</p>
      <CtaGroup ctas={hero.ctas} stackOnPhone class="pt-2 max-lg:justify-center" />
    </div>
    <ShotPlate
      shot={hero.visual}
      priority
      lifted
      class="lg:-mr-[calc((100vw-min(100vw,75rem))/2+3rem+1px)] lg:rounded-r-none lg:border-r-0 lg:p-3.5 lg:pr-0"
    />
  </div>
</section>
