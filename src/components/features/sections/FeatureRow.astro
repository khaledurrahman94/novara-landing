---
import type { FeatureRowContent } from '../../../content/feature-pages/types';
import Icon from '../../shared/ui/Icon.astro';
import CtaGroup from '../ui/CtaGroup.astro';
import ShotPlate from '../ui/ShotPlate.astro';
import { type } from '../ui/typography';

interface Props {
  row: FeatureRowContent;
  level?: 2 | 3;
  plateTone?: 'plate' | 'white';
}
const { row, level = 2, plateTone = 'plate' } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
const visualFirst = row.side !== 'right';
---
<div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
  <div class:list={['flex flex-col gap-4 lg:col-span-5', visualFirst && 'lg:order-2']}>
    {row.badge && (
      <span class="self-start rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-[0.8125rem] font-semibold text-primary-700">{row.badge}</span>
    )}
    {row.eyebrow && <p class={type.eyebrow}>{row.eyebrow}</p>}
    <Heading class={level === 3 ? type.h3 : type.h2}>{row.title}</Heading>
    <p class:list={[level === 3 ? type.body : type.lead, 'max-w-[32rem]']}>{row.text}</p>
    {row.points && (
      <ul class="m-0 mt-1 flex list-none flex-col gap-2.5 p-0">
        {row.points.map((point) => (
          <li class="flex items-start gap-2.5 text-[0.9375rem] leading-relaxed text-text-secondary">
            <span class="mt-1 grid size-4 shrink-0 place-items-center rounded-full bg-primary-50 text-primary-700"><Icon name="check" size={12} /></span>
            {point}
          </li>
        ))}
      </ul>
    )}
    {row.ctas && <CtaGroup ctas={row.ctas} stackOnPhone class="pt-3" />}
  </div>
  <div class:list={['min-w-0 lg:col-span-7', visualFirst && 'lg:order-1']}>
    <slot name="visual">
      <ShotPlate shot={row.visual} tone={plateTone} />
    </slot>
  </div>
</div>
