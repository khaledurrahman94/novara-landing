---
import Icon from '../shared/ui/Icon.astro';
import { toneDot, type Tone } from '../shared/ui/tone';
import { blog } from '../../content/blog';
/**
 * Closing section: big centred heading over the page's one brand-gradient horizon, with floating product chips
 * (hidden on phones, still under reduced motion) and a single "Hire the best team" action.
 */
const { close } = blog;
const spots = ['left-[8%] bottom-[22%]', 'right-[6%] top-[22%]', 'right-[9%] bottom-[16%]'];
const floats = ['blog-float-2', 'blog-float-3', 'blog-float-1'];
---
<section aria-labelledby="blog-close-title" class="border-t border-border-secondary bg-white">
  <div class="relative mx-auto w-full max-w-[75rem] overflow-hidden border-x border-border-secondary px-5 py-20 text-center sm:px-8 md:px-12 md:py-28 lg:py-32">
    <div class="blog-horizon pointer-events-none absolute -bottom-48 -left-[10%] -right-[10%] h-[26rem] opacity-50" aria-hidden="true"></div>
    <div class="blog-close-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
      <div class="blog-float-1 absolute left-[5%] top-[18%] flex items-center gap-2.5 rounded-lg border border-border-secondary bg-white px-3.5 py-2.5 text-left font-ui shadow-lg">
        <span class="grid size-9 place-items-center rounded-full border-[3px] border-primary text-xs font-semibold">{close.score.value}</span>
        <span><span class="block text-[0.6875rem] font-medium text-text-tertiary">{close.score.label}</span><span class="block text-[0.8125rem] font-semibold">{close.score.name}</span></span>
      </div>
      {close.chips.map((c, i) => (
        <div class:list={['absolute flex items-center gap-2 rounded-full border border-border-secondary bg-white py-1.5 pl-2 pr-3 font-ui text-xs font-medium text-text-secondary shadow-lg', spots[i], floats[i]]}>
          <span class:list={['size-1.5 rounded-full', toneDot[c.tone as Tone]]}></span>{c.text}
        </div>
      ))}
    </div>

    <div class="relative mx-auto flex max-w-[44rem] flex-col items-center">
      <p class="m-0 inline-flex items-center gap-2 rounded-full border border-border-secondary bg-white px-3 py-1 text-sm font-medium text-text-secondary">
        <span class="size-1.5 rounded-full bg-primary" aria-hidden="true"></span>{close.badge}
      </p>
      <h2 id="blog-close-title" class="m-0 mt-5 text-balance text-[clamp(2.25rem,1.2rem+4vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.03em]">{close.title}</h2>
      <p class="m-0 mt-5 max-w-[34rem] text-base leading-relaxed text-text-secondary sm:text-lg">{close.line}</p>
      <a href={close.cta.href} class="blog-cta mt-9 inline-flex h-12 items-center gap-2.5 rounded-full bg-primary px-6 text-base font-medium text-white no-underline shadow-md transition-colors duration-[var(--duration-fast)] hover:bg-primary-600">
        {close.cta.label}<Icon name="arrow-right" size={18} class="blog-cta-arrow" />
      </a>
    </div>
  </div>
</section>
