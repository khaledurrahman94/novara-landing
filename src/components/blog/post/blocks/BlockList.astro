---
import Inline from '../Inline.astro';
import type { RichLine } from '../../../../lib/blog';
/** Bullet (or numbered) list; an item's `lead` renders bold with a colon, as in the Vivasoft reference. */
interface Props { items: RichLine[]; ordered?: boolean }
const { items, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---
<Tag class:list={['post-list', ordered && 'post-list-ordered']}>
  {items.map((it) => (
    <li>{it.lead && <strong>{it.lead}: </strong>}<Inline text={it.text} /></li>
  ))}
</Tag>
