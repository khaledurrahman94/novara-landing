---
import Icon from '../../../shared/ui/Icon.astro';
import { IMAGE_SPECS, type PostImageKind } from '../../../../lib/blog';
/**
 * Body or information image. Sizes for the marketing team: IMAGE_SPECS (src/lib/blog.ts). Until a real `src`
 * exists a neutral placeholder renders; in dev it also shows the size the file should be.
 */
interface Props { kind: PostImageKind; src?: string | undefined; alt: string; caption?: string | undefined; width?: number | undefined; height?: number | undefined }
const { kind, src, alt, caption, width, height } = Astro.props;
const spec = IMAGE_SPECS[kind];
const specText = `${kind === 'info' ? 'Information' : 'Body'} image · ${spec.width} × ${spec.height} (${spec.ratio})${kind === 'info' ? ` · text ≥ ${IMAGE_SPECS.info.minTextPx} px` : ''}`;
---
<figure class="post-block m-0">
  {src ? (
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" class:list={['block w-full rounded-lg border border-border-secondary', kind === 'info' ? 'aspect-video bg-white object-contain' : 'aspect-video object-cover']} />
  ) : (
    <div role="img" aria-label={alt} class="relative grid aspect-video place-items-center overflow-hidden rounded-lg border border-border-secondary bg-bg">
      <div class="blog-grid absolute inset-0" aria-hidden="true"></div>
      <span class="relative grid size-14 place-items-center rounded-lg border border-border-secondary bg-white text-primary shadow-md" aria-hidden="true"><Icon name={kind === 'info' ? 'chart' : 'window'} size={24} /></span>
      {import.meta.env.DEV && <span class="absolute left-3 top-3 rounded-md bg-white/80 px-2 py-1 font-ui text-[0.6875rem] font-medium text-text-secondary">{specText}</span>}
    </div>
  )}
  {caption && <figcaption class="mt-3 text-sm text-text-tertiary">{caption}</figcaption>}
</figure>
