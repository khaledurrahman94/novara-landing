---
import Icon from '../../../shared/ui/Icon.astro';
/**
 * Built-in information graphic: numbered steps in product-UI style (4 across, 2 × 2 on phones). Use an `image`
 * block with kind "info" instead when marketing supplies a designed infographic.
 */
interface Props { title: string; caption?: string | undefined; items: { title: string; text: string; icon: string }[] }
const { title, caption, items } = Astro.props;
---
<figure class="post-block m-0">
  <div class="rounded-lg border border-border-secondary bg-bg p-4 sm:p-8">
    <p class="m-0 text-center text-lg font-semibold tracking-[-0.01em]">{title}</p>
    <ol class="m-0 mt-6 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-4">
      {items.map((s, i) => (
        <li class="rounded-lg border border-border-secondary bg-white px-4 py-5 text-center">
          <span class="mx-auto grid size-11 place-items-center rounded-md bg-primary-50 text-primary"><Icon name={s.icon} size={20} /></span>
          <span class="mt-3 block font-ui text-[0.6875rem] font-semibold text-primary-700">STEP {i + 1}</span>
          <span class="mt-1 block text-base font-semibold">{s.title}</span>
          <span class="mt-1 block text-[0.8125rem] leading-snug text-text-tertiary">{s.text}</span>
        </li>
      ))}
    </ol>
    <div class="mt-6 flex h-2 gap-0.5 overflow-hidden rounded-full" aria-hidden="true">
      <span class="flex-[4] bg-primary-200"></span><span class="flex-[3] bg-primary-300"></span><span class="flex-[2] bg-primary-400"></span><span class="flex-1 bg-primary"></span>
    </div>
  </div>
  {caption && <figcaption class="mt-3 text-sm text-text-tertiary">{caption}</figcaption>}
</figure>
