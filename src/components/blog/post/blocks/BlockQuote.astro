---
import Inline from '../Inline.astro';
interface Props { text: string; cite?: string | undefined }
const { text, cite } = Astro.props;
---
<blockquote class="post-block m-0 rounded-lg border border-border-secondary bg-bg px-6 py-5">
  <p class="m-0 text-lg leading-relaxed text-text-primary"><Inline text={text} /></p>
  {cite && <footer class="mt-3 text-sm text-text-tertiary">{cite}</footer>}
</blockquote>
