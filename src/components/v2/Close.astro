---
import { v2 } from '../../content/v2';
import Section from './Section.astro';
import DemoForm from '../shared/DemoForm.astro';
const { close, form } = v2;
---
<Section id="demo-close" labelledby="close-title" tone="plate">
  <div class="mx-auto flex max-w-[40rem] flex-col items-center text-center">
    <h2 id="close-title" class="m-0 text-[clamp(2rem,1.2rem+2.8vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.03em]">{close.title}</h2>
    <p class="m-0 mt-5 text-lg leading-relaxed text-text-secondary">{close.line}</p>
    <div class="mt-8 flex w-full justify-center text-left">
      <DemoForm id="demo-close-form" {...form} />
    </div>
  </div>
</Section>
