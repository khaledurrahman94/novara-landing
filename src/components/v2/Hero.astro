---
import { v2 } from '../../content/v2';
import DemoForm from '../shared/DemoForm.astro';
import CandidateReview from '../shared/ui/CandidateReview.astro';
const { hero, form } = v2;
---
<section data-hero id="top" aria-labelledby="hero-title" class="relative bg-white">
  <div class="mx-auto w-full max-w-[1200px] border-x border-border-secondary px-5 pb-20 pt-16 sm:px-8 md:px-12 md:pb-32 md:pt-24">
    <div class="max-w-[46rem]">
      <h1 id="hero-title" class="m-0 text-[clamp(2.75rem,1.2rem+5.2vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.03em]">{hero.title}</h1>
      <p data-rise class="m-0 mt-5 max-w-[34rem] text-lg leading-relaxed text-text-secondary">{hero.sub}</p>
      <div data-rise class="mt-8">
        <DemoForm id="demo-hero" {...form} />
      </div>
    </div>

    <div data-shot-stage class="relative mt-14 md:mt-16" style="perspective: 1800px">
      <div class="v2-horizon pointer-events-none absolute -top-16 left-[-10%] right-[-10%] h-[26rem] opacity-50" aria-hidden="true"></div>
      <figure data-shot class="relative m-0" style="transform-origin: 50% 0">
        <CandidateReview />
        <figcaption class="sr-only">{hero.shotCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>
