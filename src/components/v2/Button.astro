---
interface Props { href: string; variant?: 'primary' | 'secondary'; class?: string; [key: string]: unknown }
const { href, variant = 'primary', class: cls = '', ...rest } = Astro.props;
const styles = {
  primary: 'bg-primary text-white shadow-xs hover:bg-primary-600',
  secondary: 'border border-border-primary bg-white text-text-secondary shadow-xs hover:bg-bg',
};
---
<a
  href={href}
  {...rest}
  class:list={[
    'inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-md px-4 text-sm font-medium no-underline',
    'transition-[background-color,box-shadow] duration-[var(--duration-fast)] ease-[var(--ease-out-quart)]',
    styles[variant],
    cls,
  ]}
><slot /></a>
