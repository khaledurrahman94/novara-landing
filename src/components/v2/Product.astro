---
import { v2 } from '../../content/v2';
import { candidates } from '../../data/demo';
import Section from './Section.astro';
import Figure from './Figure.astro';
import MoveBoard from './MoveBoard.astro';
import ApplicantList from '../shared/ui/ApplicantList.astro';
import JobFitCard from '../shared/ui/JobFitCard.astro';
import InterviewFrame from '../shared/ui/InterviewFrame.astro';
import IntegrityTrack from './IntegrityTrack.astro';
import InterviewScore from '../shared/ui/InterviewScore.astro';
const { screen, interview, decide } = v2.features;
const h2 = 'm-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]';
const lead = 'm-0 mt-5 max-w-[30rem] text-lg leading-relaxed text-text-secondary';
---
<Section id="product" labelledby="screen-title">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 id="screen-title" class={h2}>{screen.title}</h2>
      <p class={lead}>{screen.line}</p>
    </div>
    <Figure caption={screen.caption} class="lg:col-span-8" >
      <div data-feature="screen" class="grid items-start gap-4 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
        <ApplicantList rows={candidates} showStage={false} class="max-w-none!" />
        <JobFitCard variant="full" class="max-w-none!" />
      </div>
    </Figure>
  </div>
</Section>

<Section tone="plate" labelledby="interview-title">
  <div class="grid items-end gap-6 lg:grid-cols-12 lg:gap-16">
    <h2 id="interview-title" class={`${h2} lg:col-span-7`}>{interview.title}</h2>
    <p class="m-0 max-w-[30rem] text-lg leading-relaxed text-text-secondary lg:col-span-5">{interview.line}</p>
  </div>
  <Figure caption={interview.caption} tone="white" class="mt-12">
    <div data-feature="interview" class="flex flex-col gap-4">
      <InterviewFrame fill markSrc="/brand/novara-mark.svg" class="min-h-[18rem] lg:h-[26rem]!" />
      <IntegrityTrack />
    </div>
  </Figure>
</Section>

<Section labelledby="decide-title">
  <div class="mx-auto max-w-[44rem] text-center">
    <h2 id="decide-title" class={h2}>{decide.title}</h2>
    <p class="m-0 mx-auto mt-5 max-w-[34rem] text-lg leading-relaxed text-text-secondary">{decide.line}</p>
  </div>
  <Figure caption={decide.caption} class="mt-14">
    <div data-feature="decide" class="grid items-start gap-4 md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
      <InterviewScore class="max-w-none!" />
      <MoveBoard />
    </div>
  </Figure>
</Section>
