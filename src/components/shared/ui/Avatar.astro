---
interface Props { initials: string; size?: 'xs' | 'sm' | 'md'; lead?: boolean; class?: string }
const { initials, size = 'sm', lead = false, class: cls = '' } = Astro.props;
const sizes = { xs: 'size-5 text-[0.5625rem]', sm: 'size-8 text-xs', md: 'size-10 text-sm' };
---
<span
  aria-hidden="true"
  class:list={['inline-grid shrink-0 place-items-center rounded-full font-ui font-semibold', sizes[size], lead ? 'bg-primary-100 text-primary-800' : 'bg-gray-100 text-text-secondary', cls]}
>{initials}</span>
