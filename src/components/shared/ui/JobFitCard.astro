---
import ScoreRing from './ScoreRing.astro';
import ScoreChip from './ScoreChip.astro';
import Icon from './Icon.astro';
import { fit, lead, role } from '../../../data/demo';
/**
 * Job Fit Score card (resume vs job).
 * variant: 'full' ring plus detail | 'detail' criteria and reasoning | 'ring' compact ring only.
 * compact: tighter spacing, a smaller ring and the reasoning clamped to three lines (the home hero).
 */
interface Props {
  variant?: 'full' | 'detail' | 'ring';
  compact?: boolean;
  name?: string;
  roleTitle?: string;
  score?: number;
  matched?: readonly string[];
  missing?: readonly { label: string; note: string }[];
  reasoning?: string;
  class?: string;
}
const {
  variant = 'full',
  compact = false,
  name = lead.name,
  roleTitle = role.title,
  score = fit.score,
  matched = fit.matched,
  missing = fit.missing,
  reasoning = fit.reasoning,
  class: cls = '',
} = Astro.props;
const first = name.split(' ')[0];
---
<div class:list={['w-full rounded-lg border border-border-secondary bg-bg-secondary font-ui text-text-primary shadow-md', variant === 'ring' ? 'max-w-[15rem] p-4' : compact ? 'max-w-[25rem] p-3.5' : 'max-w-[28rem] p-5', cls]} data-card="job-fit">
  {variant === 'ring' ? (
    <div class="flex flex-col items-center text-center">
      <p class="m-0 self-start text-xs font-semibold text-text-tertiary">Job Fit Score</p>
      <ScoreRing score={score} size={132} stroke={10} class="my-3" />
      <p class="m-0 text-sm font-semibold">{name}</p>
      <p class="m-0 text-xs text-text-tertiary">{roleTitle}</p>
      {score >= 80 ? <ScoreChip score={score} band class="mt-3" /> : <ScoreChip score={score} class="mt-3" />}
    </div>
  ) : (
    <>
      <div class:list={['flex items-center', compact ? 'gap-3' : 'gap-4']}>
        {variant === 'full' && (compact ? (
          <div data-anim="ring" class="relative shrink-0 overflow-hidden rounded-full">
            <ScoreRing score={score} size={52} stroke={5} />
            <span data-anim="shimmer" aria-hidden="true" class="pointer-events-none absolute inset-y-0 -left-full w-full bg-gradient-to-r from-transparent via-white/60 to-transparent"></span>
          </div>
        ) : <ScoreRing score={score} size={84} stroke={8} />)}
        <div class="min-w-0 flex-1">
          <p class="m-0 text-xs font-medium text-text-tertiary">Job Fit Score</p>
          <p class:list={['m-0 truncate font-semibold', compact ? 'text-[0.9375rem]' : 'text-base']}>{name}</p>
          <p class="m-0 truncate text-xs text-text-tertiary">{roleTitle}</p>
        </div>
        {variant === 'detail' && <span class="text-3xl font-semibold tabular-nums">{score}%</span>}
      </div>

      <div class:list={['border-t border-border-secondary', compact ? 'mt-2.5 pt-2.5' : 'mt-5 pt-4']}>
        <p data-anim="criteria-head" class:list={['m-0 text-xs font-semibold text-text-tertiary', compact ? 'mb-1' : 'mb-2']}>Matched ({matched.length})</p>
        <ul class:list={['m-0 flex list-none flex-col p-0', compact ? 'gap-0.5' : 'gap-1.5']}>
          {matched.map((m) => (
            <li data-anim="criteria-row" data-state="match" class:list={['flex items-center text-text-secondary', compact ? 'gap-2 text-[0.8125rem]' : 'gap-2.5 text-[0.8125rem]']}>
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-success/10 text-success"><Icon name="check" size={12} /></span>
              {m}
            </li>
          ))}
        </ul>
        <p data-anim="criteria-head" class:list={['m-0 text-xs font-semibold text-text-tertiary', compact ? 'mb-1 mt-2.5' : 'mb-2 mt-4']}>Missing ({missing.length})</p>
        <ul class:list={['m-0 flex list-none flex-col p-0', compact ? 'gap-0.5' : 'gap-1.5']}>
          {missing.map((m) => (
            <li data-anim="criteria-row" data-state="miss" class:list={['flex items-center text-text-secondary', compact ? 'gap-2 text-[0.8125rem]' : 'gap-2.5 text-[0.8125rem]']}>
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-warning/10 text-warning"><Icon name="alert" size={12} /></span>
              <span>{m.label} <span class="text-text-tertiary">({m.note})</span></span>
            </li>
          ))}
        </ul>
      </div>

      <div data-anim="why" class:list={['rounded-md bg-bg-tertiary', compact ? 'mt-2.5 p-2.5' : 'mt-4 p-3.5']}>
        <p class:list={['m-0 flex items-center gap-1.5 text-xs font-semibold text-text-primary', compact ? 'mb-1' : 'mb-1.5']}>
          <Icon name="sparkles" size={13} class="text-primary" />Why Novara ranks {first} here
        </p>
        <p data-anim="reasoning" class:list={['m-0 text-text-secondary', compact ? 'line-clamp-3 text-[0.71875rem] leading-[1.45]' : 'text-[0.8125rem] leading-[1.55]']}>{reasoning}</p>
      </div>
    </>
  )}
</div>
