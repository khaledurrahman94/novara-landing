---
import ScoreRing from './ScoreRing.astro';
import ScoreChip from './ScoreChip.astro';
import Icon from './Icon.astro';
import { fit, lead, role } from '../../../data/demo';
/**
 * Job Fit Score card (resume vs job).
 * variant: 'full' ring plus detail | 'detail' criteria and reasoning | 'ring' compact ring only.
 */
interface Props {
  variant?: 'full' | 'detail' | 'ring';
  name?: string;
  roleTitle?: string;
  score?: number;
  matched?: readonly string[];
  missing?: readonly { label: string; note: string }[];
  reasoning?: string;
  class?: string;
}
const {
  variant = 'full',
  name = lead.name,
  roleTitle = role.title,
  score = fit.score,
  matched = fit.matched,
  missing = fit.missing,
  reasoning = fit.reasoning,
  class: cls = '',
} = Astro.props;
const first = name.split(' ')[0];
---
<div class:list={['w-full rounded-lg border border-border-secondary bg-bg-secondary font-ui text-text-primary shadow-md', variant === 'ring' ? 'max-w-[15rem] p-4' : 'max-w-[28rem] p-5', cls]} data-card="job-fit">
  {variant === 'ring' ? (
    <div class="flex flex-col items-center text-center">
      <p class="m-0 self-start text-xs font-semibold text-text-tertiary">Job Fit Score</p>
      <ScoreRing score={score} size={132} stroke={10} class="my-3" />
      <p class="m-0 text-sm font-semibold">{name}</p>
      <p class="m-0 text-xs text-text-tertiary">{roleTitle}</p>
      {score >= 80 ? <ScoreChip score={score} band class="mt-3" /> : <ScoreChip score={score} class="mt-3" />}
    </div>
  ) : (
    <>
      <div class="flex items-center gap-4">
        {variant === 'full' && <ScoreRing score={score} size={84} stroke={8} />}
        <div class="min-w-0 flex-1">
          <p class="m-0 text-xs font-medium text-text-tertiary">Job Fit Score</p>
          <p class="m-0 truncate text-base font-semibold">{name}</p>
          <p class="m-0 truncate text-xs text-text-tertiary">{roleTitle}</p>
        </div>
        {variant === 'detail' && <span class="text-3xl font-semibold tabular-nums">{score}%</span>}
      </div>

      <div class="mt-5 border-t border-border-secondary pt-4">
        <p class="m-0 mb-2 text-xs font-semibold text-text-tertiary">Matched ({matched.length})</p>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {matched.map((m) => (
            <li data-anim="criteria-row" class="flex items-center gap-2.5 text-[0.8125rem] text-text-secondary">
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-success/10 text-success"><Icon name="check" size={12} /></span>
              {m}
            </li>
          ))}
        </ul>
        <p class="m-0 mb-2 mt-4 text-xs font-semibold text-text-tertiary">Missing ({missing.length})</p>
        <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
          {missing.map((m) => (
            <li data-anim="criteria-row" class="flex items-center gap-2.5 text-[0.8125rem] text-text-secondary">
              <span class="grid size-5 shrink-0 place-items-center rounded-full bg-warning/10 text-warning"><Icon name="alert" size={12} /></span>
              <span>{m.label} <span class="text-text-tertiary">({m.note})</span></span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-4 rounded-md bg-bg-tertiary p-3.5">
        <p class="m-0 mb-1.5 flex items-center gap-1.5 text-xs font-semibold text-text-primary">
          <Icon name="sparkles" size={13} class="text-primary" />Why Novara ranks {first} here
        </p>
        <p data-anim="reasoning" class="m-0 text-[0.8125rem] leading-[1.55] text-text-secondary">{reasoning}</p>
      </div>
    </>
  )}
</div>
