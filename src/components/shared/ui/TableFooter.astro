---
import Icon from './Icon.astro';
/** Pagination row as the dashboard shows it: Page x of y, numbered buttons, Show: 10 Row. */
interface Props { pages: number; class?: string }
const { pages, class: cls = '' } = Astro.props;
---
<div class:list={['flex items-center justify-between gap-2 border-t border-border-secondary px-3 py-2 text-[0.6875rem] text-text-secondary', cls]} aria-hidden="true">
  <span>Page 1 of {pages}</span>
  <span class="hidden items-center gap-1 @lg:flex">
    <span class="grid size-6 place-items-center rounded-md bg-primary text-[0.6875rem] font-medium text-white">1</span>
    <span class="grid size-6 place-items-center">2</span>
    <span class="grid size-6 place-items-center">3</span>
    <span class="grid size-6 place-items-center"><Icon name="chevron-right" size={12} /></span>
  </span>
  <span class="hidden items-center gap-1.5 @md:flex">Show:<span class="inline-flex items-center gap-1 rounded-md border border-border-secondary px-2 py-1">10 Row<Icon name="chevron-down" size={11} /></span></span>
</div>
