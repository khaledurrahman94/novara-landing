---
import AppFrame from './AppFrame.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import ScoreChip from './ScoreChip.astro';
import TableFooter from './TableFooter.astro';
import { profile } from '../../../data/platform';
import type { Tone } from './tone';
/**
 * Candidate profile with the Job history tab: Job role, Applied at, Job fit score and AI Interview score as
 * percent chips (green from 80, Strong Match), and the current interview stage. Illustrative recreation.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const stateTone: Record<string, Tone> = { Scheduled: 'blue', Completed: 'success', 'Pre-Scheduled': 'gray' };
const cols = 'grid-cols-[minmax(0,1fr)_3.25rem_3.25rem] @xl:grid-cols-[minmax(0,1.4fr)_4.5rem_3.5rem_3.5rem_minmax(0,1.3fr)]';
---
<AppFrame title="Candidates" action="Create New Job Post" active="candidates" class={cls}>
  <div class="flex flex-col gap-3 @2xl:flex-row">
    <aside aria-label="Candidate" class="flex shrink-0 flex-col items-center rounded-lg border border-border-secondary bg-white p-3 text-center @2xl:w-44">
      <span class="grid size-12 place-items-center rounded-full bg-primary-100 text-sm font-semibold text-primary-800" aria-hidden="true">{profile.initials}</span>
      <p class="m-0 mt-2 text-[0.8125rem] font-semibold">{profile.name}</p>
      <p class="m-0 break-all text-[0.625rem] text-text-tertiary">{profile.email}</p>
      <ul class="m-0 mt-2.5 flex list-none flex-wrap justify-center gap-1 p-0">
        {profile.skills.map((s) => <li class="rounded-sm bg-gray-100 px-1.5 py-0.5 text-[0.625rem] font-medium text-text-secondary">{s}</li>)}
      </ul>
      <div class="mt-3 flex w-full flex-col gap-1.5 text-[0.6875rem] font-medium" aria-hidden="true">
        <span class="inline-flex h-7 items-center justify-center gap-1.5 rounded-md bg-primary text-white"><Icon name="sparkles" size={12} />Check Job Fit Score</span>
        <span class="inline-flex h-7 items-center justify-center gap-1.5 rounded-md border border-border-primary text-text-secondary"><Icon name="mail" size={12} />Send Email</span>
        <span class="inline-flex h-7 items-center justify-center gap-1.5 rounded-md border border-border-primary text-text-secondary"><Icon name="ban" size={12} />Blacklist</span>
      </div>
    </aside>

    <section aria-label="Job history" class="min-w-0 flex-1 overflow-hidden rounded-lg border border-border-secondary bg-white">
      <div class="flex gap-4 border-b border-border-secondary px-3 pt-2 text-[0.6875rem] font-medium tracking-wide text-text-tertiary" aria-hidden="true">
        <span class="border-b-2 border-primary pb-2 text-text-primary">JOB HISTORY ({profile.history.length})</span>
        <span class="pb-2">RESUME (3)</span>
        <span class="hidden pb-2 @md:block">ACTIVITY LOG</span>
      </div>
      <div class:list={['grid items-center gap-x-3 bg-bg-tertiary px-3 py-1.5 text-[0.6875rem] font-medium text-text-primary', cols]}>
        <span>Job role</span><span class="hidden @xl:block">Applied at</span><span>Job fit</span><span>AI Interview</span><span class="hidden @xl:block">Interview stage</span>
      </div>
      <ul class="m-0 list-none p-0">
        {profile.history.map((h) => (
          <li class:list={['grid items-center gap-x-3 border-b border-border-secondary px-3 py-2 text-[0.6875rem] last:border-b-0', cols]}>
            <span class="min-w-0">
              <span class="block truncate text-xs font-medium text-text-primary">{h.role}</span>
              <span class="flex items-center gap-1 truncate text-[0.625rem] text-text-tertiary"><span class:list={['size-1.5 shrink-0 rounded-full', h.live ? 'bg-success' : 'bg-gray-400']} aria-hidden="true"></span>{h.deadline}</span>
            </span>
            <span class="hidden text-text-secondary @xl:block">{h.applied}</span>
            <span><ScoreChip score={h.fit} /></span>
            <span>{h.ai > 0 ? <ScoreChip score={h.ai} /> : <span class="text-text-placeholder">-</span>}</span>
            <span class="hidden items-center gap-1.5 text-text-secondary @xl:flex">
              {h.stage === 'AI Interview' ? (
                <>AI Interview<Chip tone={stateTone[h.state] ?? 'gray'} dot={false} class="!rounded-sm !px-1.5 !py-0.5 !text-[0.625rem]">{h.state}</Chip></>
              ) : (
                <><span class:list={['size-1.5 rounded-full', h.stage === 'Offered' ? 'bg-success' : 'bg-blue-light']} aria-hidden="true"></span>{h.stage}</>
              )}
            </span>
          </li>
        ))}
      </ul>
      <TableFooter pages={2} />
    </section>
  </div>
</AppFrame>
