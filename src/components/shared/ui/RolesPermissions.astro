---
import AppFrame from './AppFrame.astro';
import Icon from './Icon.astro';
import { rolesData } from '../../../data/platform';
/**
 * Roles and Permissions: the role list on the left, the selected role's access scope and permission groups
 * on the right. The home page selects each role in turn to show what it can do (system roles are read-only).
 * The role names are Admin, HR Manager and Recruiter; which permission each holds here is illustrative.
 * Hooks: [data-roles-card], [data-role][data-selected], [data-perm][data-roles], [data-role-title], [data-role-users], [data-role-perms], [data-group-count].
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const first = rolesData.roles[0]!;
const holds = (on: readonly string[], key: string): boolean => on.includes(key);
const permCount = (key: string): number => rolesData.groups.reduce((n, g) => n + g.items.filter((i) => holds(i.on, key)).length, 0);
const rolePerms = Object.fromEntries(rolesData.roles.map((r) => [r.key, permCount(r.key)]));
---
<AppFrame title="Roles & Permissions" active="roles" class={cls}>
  <div data-roles-card class="flex flex-col gap-3 @2xl:flex-row" data-role-perms-map={JSON.stringify(rolePerms)}>
    <div class="flex shrink-0 flex-row gap-2 @2xl:w-40 @2xl:flex-col">
      <span class="hidden items-center gap-1.5 rounded-md border border-border-secondary bg-white px-2 py-1.5 text-[0.6875rem] text-text-tertiary @2xl:flex" aria-hidden="true"><Icon name="search" size={11} />Search roles</span>
      <span class="hidden h-7 items-center justify-center gap-1 rounded-md bg-primary text-[0.6875rem] font-medium text-white @2xl:inline-flex" aria-hidden="true"><Icon name="plus" size={12} />Create Role</span>
      {rolesData.roles.map((r) => (
        <div
          data-role={r.key}
          data-users={r.users}
          data-name={r.name}
          data-selected={r.key === first.key ? 'true' : 'false'}
          class="min-w-0 flex-1 rounded-lg border border-border-secondary bg-white p-2 text-left transition-[border-color,background-color] duration-[var(--duration-base)] data-[selected=true]:border-primary data-[selected=true]:bg-primary-50 @2xl:flex-none"
        >
          <span class="block truncate text-xs font-semibold text-text-primary">{r.name}</span>
          <span class="mt-1 inline-block rounded-sm bg-gray-100 px-1.5 py-0.5 text-[0.625rem] text-text-secondary">System</span>
          <span class="mt-1 block text-[0.625rem] text-text-tertiary">{r.users} users</span>
        </div>
      ))}
    </div>

    <div class="min-w-0 flex-1 rounded-lg border border-border-secondary bg-white p-3">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <span class="inline-block rounded-full bg-gray-100 px-2 py-0.5 text-[0.5625rem] font-medium tracking-wide text-text-secondary">SYSTEM ROLE (READ-ONLY)</span>
          <p data-role-title class="m-0 mt-1.5 text-sm font-semibold">{first.name}</p>
        </div>
        <dl class="m-0 flex shrink-0 gap-4 text-right">
          <div><dt class="text-[0.5625rem] font-medium tracking-wide text-text-tertiary">USERS</dt><dd data-role-users class="m-0 text-xs font-semibold tabular-nums">{first.users}</dd></div>
          <div><dt class="text-[0.5625rem] font-medium tracking-wide text-text-tertiary">PERMISSIONS</dt><dd data-role-perms class="m-0 text-xs font-semibold tabular-nums">{rolePerms[first.key]}</dd></div>
        </dl>
      </div>
      <p class="m-0 mt-3 text-xs font-semibold">Access Scope</p>
      <div class="mt-1.5 grid grid-cols-2 gap-2 text-[0.6875rem]" aria-hidden="true">
        <span class="rounded-md border border-primary bg-primary-50 p-2"><span class="flex items-center gap-1.5 font-medium"><span class="size-2.5 rounded-full border-[3px] border-primary bg-white"></span>All Jobs</span><span class="mt-0.5 block text-[0.625rem] text-text-tertiary">Every job in the company</span></span>
        <span class="rounded-md border border-border-secondary p-2"><span class="flex items-center gap-1.5 font-medium"><span class="size-2.5 rounded-full border border-border-primary"></span>My Jobs</span><span class="mt-0.5 block text-[0.625rem] text-text-tertiary">Only jobs this user created or is assigned to</span></span>
      </div>
      <div class="mt-3 flex flex-col gap-2">
        {rolesData.groups.map((g) => (
          <section aria-label={g.name} data-group class="rounded-md border border-border-secondary p-2.5">
            <div class="flex items-center gap-2">
              <span class="grid size-3.5 place-items-center rounded-sm bg-primary-300 text-white" aria-hidden="true"><Icon name="check" size={10} /></span>
              <p class="m-0 text-xs font-semibold">{g.name}</p>
              <span class="rounded-full bg-primary-50 px-1.5 py-0.5 text-[0.5625rem] font-medium text-primary-700">Access-scoped</span>
              <span data-group-count data-total={g.items.length} class="ml-auto text-[0.625rem] font-medium tabular-nums text-text-secondary">{g.items.filter((i) => holds(i.on, first.key)).length}/{g.items.length} selected</span>
            </div>
            <ul class="m-0 mt-2 grid list-none gap-1.5 p-0 pl-5 @xl:grid-cols-2">
              {g.items.map((i) => (
                <li class="flex items-center gap-2 text-[0.6875rem] text-text-secondary">
                  <span role="checkbox" aria-readonly="true" aria-label={i.label} aria-checked={holds(i.on, first.key) ? 'true' : 'false'} data-perm data-roles={i.on.join(' ')} class="grid size-3.5 shrink-0 place-items-center rounded-sm border border-border-primary bg-white text-transparent transition-[background-color,border-color] duration-[var(--duration-base)] aria-checked:border-primary-300 aria-checked:bg-primary-300 aria-checked:text-white">
                    <Icon name="check" size={10} />
                  </span>
                  {i.label}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>
</AppFrame>
