---
import Icon from './Icon.astro';
import { careerJobs, embed } from '../../../data/demo';
/** Career page: job list plus the "Embed on your site" code line. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const embedText = embed.join(String.fromCharCode(10));
---
<div class:list={['w-full max-w-[34rem] overflow-hidden rounded-lg border border-border-secondary bg-bg-secondary font-ui text-text-primary shadow-md', cls]} data-card="career-page">
  <div class="flex items-center gap-2 border-b border-border-secondary bg-bg-tertiary px-3 py-2">
    <span class="flex gap-1" aria-hidden="true"><i class="size-2 rounded-full bg-border-primary"></i><i class="size-2 rounded-full bg-border-primary"></i><i class="size-2 rounded-full bg-border-primary"></i></span>
    <span class="ml-2 flex-1 truncate rounded-sm bg-bg-secondary px-2.5 py-1 text-[0.6875rem] text-text-tertiary">your-site.com/careers</span>
  </div>
  <div class="p-4">
    <p class="m-0 text-sm font-semibold">{careerJobs.length} open positions</p>
    <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0">
      {careerJobs.map((j) => (
        <li data-anim="row" class="flex items-center gap-3 rounded-md border border-border-secondary p-3">
          <div class="min-w-0 flex-1">
            <p class="m-0 truncate text-[0.8125rem] font-semibold">{j.title}</p>
            <p class="m-0 mt-0.5 flex items-center gap-1 text-xs text-text-tertiary"><Icon name="pin" size={11} />{j.meta} · {j.type}</p>
          </div>
          <span class="shrink-0 rounded-md bg-primary px-2.5 py-1.5 text-xs font-medium text-white">View details</span>
        </li>
      ))}
    </ul>
    <div class="mt-4 border-t border-border-secondary pt-4">
      <p class="m-0 mb-1.5 text-xs font-semibold text-text-tertiary">Embed on your site</p>
      <div class="flex items-start gap-2 rounded-md bg-gray-950 px-3 py-2.5">
        <code class="min-w-0 flex-1 whitespace-pre-wrap break-all font-mono text-[0.6875rem] leading-relaxed text-primary-200">{embedText}</code>
        <Icon name="copy" size={14} class="text-gray-400" />
      </div>
    </div>
  </div>
</div>
