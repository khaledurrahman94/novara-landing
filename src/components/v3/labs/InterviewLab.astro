---
import Section from '../../v2/Section.astro';
import InterviewFrame from '../../shared/ui/InterviewFrame.astro';
import Ico from './interview/Ico.astro';
import Report from './interview/Report.astro';
import { lab, kinds } from './interview/copy';
/**
 * InterviewLab: a live demo of Novara's integrity checks (tab, focus, copy, paste, full screen, looking away,
 * plus simulated camera and second face). Nothing is recorded, stored or sent. Detections run only while the
 * demo is live and on screen. Without JS, a static sample report is shown.
 */
interface Props { tone?: 'white' | 'plate' }
const { tone = 'white' } = Astro.props;
const h2 = 'm-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]';
---
<Section id={lab.id} tone={tone} labelledby="il-title">
  <div class="il" data-il>
    <script is:inline>(function(){var s=document.currentScript,r=s&&s.parentElement;if(r)r.setAttribute('data-js','');})();</script>

    <header class="max-w-[46rem]">
      <h2 id="il-title" class={h2}>{lab.title}</h2>
      <p class="m-0 mt-5 max-w-[40rem] text-lg leading-relaxed text-text-secondary">{lab.sub}</p>
    </header>

    <figure class="m-0 mt-10 md:mt-14">
      <figcaption class="sr-only">{lab.frameLabel}</figcaption>

      <!-- No JS: a static sample report. -->
      <Report sample />

      <div data-il-pin class="il-pin">
        <div
          data-il-window
          role="group"
          aria-label={lab.frameLabel}
          class:list={['il-window relative overflow-clip rounded-xl border border-border-secondary p-3 font-ui text-text-primary shadow-lg sm:p-4', tone === 'white' ? 'bg-bg' : 'bg-white']}
        >
          <div data-il-zoom class="il-zoom relative">
            <div data-il-live class="grid items-start gap-4 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]">
              <!-- Interview side -->
              <div class="flex min-w-0 flex-col gap-3">
                <div data-il-frame class="relative overflow-hidden rounded-lg">
                  <InterviewFrame markSrc="/brand/novara-mark.svg" timer="00:00" caption={lab.intro} class="max-w-none!" />
                  <div data-il-warn class="pointer-events-none absolute inset-0 rounded-lg border-2 border-warning opacity-0" aria-hidden="true"></div>
                  <div class="pointer-events-none absolute inset-x-3 top-11 flex justify-center" aria-hidden="true">
                    <p data-il-toast class="m-0 flex max-w-full items-center gap-2 rounded-md bg-white px-3 py-2 text-[13px] font-medium text-text-primary opacity-0 shadow-lg">
                      <Ico name="alert" size={15} class="text-warning" /><span data-il-toast-text class="min-w-0"></span>
                    </p>
                  </div>
                  <div class="pointer-events-none absolute inset-x-3 top-[58%] flex justify-center" aria-hidden="true">
                    <p data-il-flag class="il-ov m-0 inline-flex items-center gap-1.5 rounded-full bg-gray-950/80 px-2.5 py-1 text-xs font-medium text-white">
                      <span class="size-1.5 rounded-full bg-warning"></span><span data-il-flag-text></span>
                    </p>
                  </div>
                  <div data-il-self class="il-ov pointer-events-none absolute bottom-3 right-3 grid h-14 w-20 place-items-center rounded-md border border-white/15 bg-gray-800 text-white/80" aria-hidden="true">
                    <span data-il-self-cam class="flex flex-col items-center gap-0.5 text-[10px] font-medium" hidden><Ico name="video-off" size={16} />{lab.overlay.cameraSelf}</span>
                    <span data-il-self-faces class="flex flex-col items-center gap-0.5 text-[10px] font-medium" hidden>
                      <span class="flex items-center"><Ico name="user" size={16} /><Ico name="user" size={16} class="-ml-1 text-warning" /></span>2 faces
                    </span>
                  </div>
                </div>

                <div data-il-fade class="flex flex-col gap-3">
                  <div class="flex items-center justify-between gap-3">
                    <p data-il-step class="m-0 text-[13px] font-medium text-text-secondary">{lab.step(1, lab.questions.length)}</p>
                    <span class="flex gap-1" aria-hidden="true">
                      {lab.questions.map(() => <span data-il-dot class="h-1 w-6 rounded-full bg-gray-200 transition-colors duration-[var(--duration-base)] data-[on=true]:bg-primary"></span>)}
                    </span>
                  </div>
                  <div>
                    <div class="mb-1.5 flex flex-wrap items-baseline justify-between gap-x-3 text-xs">
                      <label for="il-answer" class="font-medium text-text-secondary">{lab.answerLabel}</label>
                      <span class="text-text-placeholder">{lab.answerHint}</span>
                    </div>
                    <textarea id="il-answer" data-il-answer data-cursor="Type" rows="2" placeholder={lab.answerPlaceholder} class="il-field"></textarea>
                  </div>
                  <div class="flex flex-wrap items-center gap-2">
                    <button type="button" data-il-next data-cursor="Next" class="il-btn il-btn-primary">{lab.next}</button>
                    <button type="button" data-il-finish data-cursor="Finish" class="il-btn il-btn-secondary">{lab.finish}</button>
                    <button type="button" data-il-fs data-cursor="Full screen" class="il-btn il-btn-secondary ml-auto">
                      <Ico name="maximize" size={16} /><span data-il-fs-text>{lab.fullscreen}</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Integrity side -->
              <div data-il-fade data-card="integrity" class="min-w-0 rounded-lg border border-border-secondary bg-bg-secondary p-4 shadow-md">
                <div class="flex items-center justify-between gap-3">
                  <p class="m-0 text-sm font-semibold">{lab.panelTitle}</p>
                  <span data-il-chip data-n="0" class="group inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-text-secondary data-[n=hit]:bg-warning/10">
                    <span class="size-1.5 rounded-full bg-gray-400 group-data-[n=hit]:bg-warning" aria-hidden="true"></span>
                    <span data-il-chip-text>{lab.review(0)}</span>
                  </span>
                </div>

                <ul class="m-0 mt-3 grid list-none grid-cols-2 gap-1.5 p-0">
                  {kinds.map((k) => (
                    <li data-il-tile={k.key} data-hit="false" class:list={['group flex items-center gap-2 rounded-md border border-border-secondary px-2 py-1.5', k.key === 'away' && 'il-fine', k.key === 'fullscreen' && 'il-nofs']}>
                      <span class="grid size-6 shrink-0 place-items-center rounded-md bg-gray-100 text-text-tertiary group-data-[hit=true]:bg-warning/10 group-data-[hit=true]:text-warning">
                        <Ico name={k.icon} size={13} />
                      </span>
                      <span class="min-w-0">
                        <span data-il-count={k.key} class="block text-[15px] font-semibold leading-none tabular-nums">0</span>
                        <span class="mt-0.5 block truncate text-[11px] leading-tight text-text-tertiary">{k.label}</span>
                      </span>
                    </li>
                  ))}
                </ul>

                <div class="mt-3 border-t border-border-secondary pt-3">
                  <p class="m-0 text-xs font-medium text-text-tertiary">{lab.simulateTitle}</p>
                  <div class="mt-1.5 flex flex-col">
                    <button type="button" role="switch" aria-checked="false" data-il-sim="camera" data-cursor="Toggle" class="il-sim">
                      <span class="il-switch" aria-hidden="true"></span>{lab.simCamera}
                    </button>
                    <button type="button" role="switch" aria-checked="false" data-il-sim="faces" data-cursor="Toggle" class="il-sim">
                      <span class="il-switch" aria-hidden="true"></span>{lab.simFaces}
                    </button>
                  </div>
                  <p class="m-0 mt-1 text-[11px] leading-snug text-text-placeholder">{lab.simulateNote}</p>
                </div>

                <div class="mt-3 border-t border-border-secondary pt-3">
                  <ol data-il-timeline class="m-0 list-none p-0"></ol>
                  <p data-il-empty class="m-0 mt-2 text-xs leading-snug text-text-tertiary">{lab.empty}</p>
                  <p class="il-fine m-0 mt-2 text-[11px] leading-snug text-text-placeholder">{lab.eyes}</p>
                </div>
              </div>
            </div>

            <Report />
          </div>
        </div>
        <p data-il-cue class="m-0 mt-4 flex items-center justify-center gap-1.5 text-xs text-text-tertiary" aria-hidden="true">
          {lab.cue}<Ico name="chevron-down" size={14} />
        </p>
      </div>
    </figure>

    <p data-il-status class="sr-only" role="status" aria-live="polite"></p>
  </div>
</Section>

<style is:global>
  .il:not([data-js]) [data-il-pin],
  .il:not([data-js]) [data-il-status] {
    display: none;
  }
  .il[data-js] [data-il-static] {
    display: none;
  }
  .il[data-intro] [data-il-fade] {
    pointer-events: none;
  }
  .il :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .il [data-il-frame] [data-anim='caption'] {
    user-select: text;
    cursor: text;
  }

  /* Buttons: the product's primary and secondary, at 40px. */
  .il-btn {
    display: inline-flex;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-xs);
    transition:
      background-color var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-fast) var(--ease-out-quart);
  }
  .il-btn:active {
    transform: scale(0.97);
  }
  .il-btn-primary {
    background: var(--color-primary);
    color: var(--color-white);
  }
  .il-btn-primary:hover {
    background: var(--color-primary-600);
  }
  .il-btn-secondary {
    background: var(--color-white);
    border-color: var(--color-border-primary);
    color: var(--color-text-secondary);
  }
  .il-btn-secondary:hover {
    background: var(--color-bg);
  }
  .il-btn[disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .il-field {
    display: block;
    width: 100%;
    resize: none;
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-md);
    background: var(--color-white);
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-primary);
    caret-color: var(--color-primary);
  }
  .il-field::placeholder {
    color: var(--color-text-placeholder);
    opacity: 1;
  }

  /* Simulate switches: whole row is the hit area. */
  .il-sim {
    display: flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.625rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    padding: 0;
    font: inherit;
    font-size: 13px;
    color: var(--color-text-secondary);
    text-align: left;
    cursor: pointer;
  }
  .il-switch {
    position: relative;
    width: 2rem;
    height: 1.125rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--color-gray-200);
    transition: background-color var(--duration-base) var(--ease-out-quart);
  }
  .il-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: var(--color-white);
    box-shadow: var(--shadow-xs);
    transition: transform var(--duration-base) var(--ease-out-quart);
  }
  .il-sim[aria-checked='true'] .il-switch {
    background: var(--color-primary);
  }
  .il-sim[aria-checked='true'] .il-switch::after {
    transform: translateX(14px);
  }

  /* Frame overlays fade with a plain opacity transition. */
  .il-ov {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out-quart);
  }
  .il-ov[data-on='true'] {
    opacity: 1;
  }

  /* No Fullscreen API (iPhone): hide its counter. */
  .il[data-fs='off'] .il-nofs {
    display: none;
  }

  /* Looking away is a mouse idea. */
  @media (pointer: coarse) {
    .il-fine {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .il-btn,
    .il-ov,
    .il-switch,
    .il-switch::after {
      transition: none;
    }
    .il-btn:active {
      transform: none;
    }
  }

  /* Full screen: the window fills the screen on white. */
  .il-window:fullscreen {
    display: grid;
    align-content: center;
    overflow: auto;
    border: 0;
    border-radius: 0;
    background: var(--color-white);
    padding: clamp(1rem, 3vw, 3rem);
  }
</style>

<script>
  import { initInterviewLab } from './interview/interview';
  initInterviewLab();
</script>
