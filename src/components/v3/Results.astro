---
import { v3 } from '../../content/v3';
import Section from '../v2/Section.astro';
const { results } = v3;
const max = Math.max(...results.figures.map((f) => f.value));
---
<Section id="results" labelledby="results-title" tone="plate">
  <div data-results class="v3-results">
    <div data-reveal>
      <h2 id="results-title" class="m-0 max-w-[40rem] text-[clamp(2rem,1.2rem+2.8vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.03em]">{results.title}</h2>
    </div>

    <figure data-funnel class="m-0 mt-14">
      <ol class="m-0 list-none border-b border-border-secondary p-0">
        {results.figures.map((f) => {
          const pct = (f.value / max) * 100;
          return (
            <li class="grid items-center gap-x-10 gap-y-3 border-t border-border-secondary py-6 md:grid-cols-[17rem_minmax(0,1fr)]">
              <div>
                <p class="m-0 flex items-baseline gap-3">
                  <span class="text-[44px] font-semibold leading-none tracking-[-0.03em] tabular-nums" data-count={f.value} data-suffix={f.suffix}>{f.value.toLocaleString('en-US')}{f.suffix}</span>
                  <span class="text-sm font-medium text-text-primary">{f.label}</span>
                </p>
                <p class="m-0 mt-2 max-w-[16rem] text-sm leading-snug text-text-tertiary">{f.note}</p>
              </div>
              <div class="relative h-9 rounded-md bg-white" aria-hidden="true">
                <div
                  data-funnel-bar
                  class:list={['h-full origin-left rounded-md', f.key === 'hired' ? 'bg-primary' : 'bg-primary-300']}
                  style={`width:max(3px, ${pct.toFixed(3)}%)`}
                ></div>
                {f.callout && (
                  <span data-funnel-callout class="absolute top-1/2 -translate-y-1/2 whitespace-nowrap text-sm font-medium text-text-primary" style={`left:calc(max(3px, ${pct.toFixed(3)}%) + 0.75rem)`}>{f.callout}</span>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </figure>

    <div data-results-stage hidden class="min-h-0 flex-1 gap-8 md:grid md:grid-cols-[13rem_minmax(0,1fr)] lg:gap-12">
      <ol data-results-legend class="m-0 hidden list-none flex-col justify-center gap-6 p-0 md:flex" aria-hidden="true">
        {results.legend.map((label) => (
          <li data-leg class="opacity-30">
            <span data-leg-count class="block text-[44px] font-semibold leading-none tracking-[-0.03em] tabular-nums">0</span>
            <span class="mt-1.5 block text-sm font-medium text-text-primary">{label}</span>
          </li>
        ))}
      </ol>
      <div class="flex min-h-0 min-w-0 flex-col">
        <div data-results-canvas-wrap class="relative min-h-0 flex-1">
          <canvas data-results-canvas tabindex="0" role="img" aria-label="1,200 applicant dots narrowing to 4 hires. Use the arrow keys to step through sample applicants." class="absolute inset-0 size-full"></canvas>
          <p data-results-live role="status" class="sr-only"></p>
          <div data-results-tip hidden class="pointer-events-none absolute left-0 top-0 z-10 whitespace-nowrap rounded-md border border-border-secondary bg-white px-2.5 py-1.5 font-ui text-xs font-medium text-text-primary shadow-md"></div>
        </div>
        <p data-results-phase class="m-0 mt-4 h-7 text-lg font-medium text-text-primary" aria-hidden="true">{results.phases[0]}</p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <p class="m-0 text-sm text-text-tertiary">{results.caption}</p>
      <p data-results-hint hidden class="m-0 text-sm text-text-tertiary">{results.hint}</p>
    </div>
  </div>
</Section>
