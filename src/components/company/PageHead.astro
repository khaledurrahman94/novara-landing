---
interface Props { eyebrow: string; title: string; line?: string }
const { eyebrow, title, line } = Astro.props;
---
<div class="border-b border-border-secondary">
  <div class="mx-auto w-full max-w-[75rem] border-x border-border-secondary px-5 pb-12 pt-16 sm:px-8 md:px-12 md:pb-16 md:pt-24">
    <p class="m-0 text-sm font-medium text-primary-700">{eyebrow}</p>
    <h1 class="m-0 mt-3 max-w-[48rem] text-[clamp(2.25rem,1.4rem+3vw,3.75rem)] font-semibold leading-[1.05] tracking-[-0.03em]">{title}</h1>
    {line && <p class="m-0 mt-5 max-w-[36rem] text-lg leading-relaxed text-text-secondary">{line}</p>}
  </div>
</div>
