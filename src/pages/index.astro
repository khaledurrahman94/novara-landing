---
/**
 * The variants showcase: four versions of the landing page side by side, so the DM team can compare how
 * their feedback changed V3. Not indexable. See docs/implementation/08-variants.md.
 */
import Base from '../layouts/Base.astro';
import { HOME_PATH } from '../lib/home-path';

interface Variant {
  id: string;
  label: string;
  path: string;
  badge: string;
  title: string;
  line: string;
  points: string[];
  featured?: boolean;
}

const variants: Variant[] = [
  {
    id: 'v4',
    label: 'V4',
    path: HOME_PATH,
    badge: 'For DM review',
    title: 'V3 plus the DM feedback',
    line: 'The page to review. It keeps V3\'s look and adds everything the DM team asked for, and every demo now plays on its own.',
    points: ['New header with Login and Get started', 'Hero image, 9-step How it works, audience section', 'Animation only: nothing to click, drag or hover'],
    featured: true,
  },
  {
    id: 'v3',
    label: 'V3',
    path: '/v3',
    badge: 'Previous winner, before the feedback',
    title: 'Bold and interactive',
    line: 'The version that won the design round. Live labs you play with, including "try to cheat", and cursor effects.',
    points: ['Screening and interview labs', 'Cursor pill and hover effects', 'Pinned, scroll-driven scenes'],
  },
  {
    id: 'v2',
    label: 'V2',
    path: '/v2',
    badge: 'Earlier exploration',
    title: 'Our standard page',
    line: 'A conventional product page: clear sections, in-flow motion and no pinned scenes.',
    points: ['Results, product, how it works, platform', 'Motion happens as you scroll past', 'FAQ and demo request close'],
  },
  {
    id: 'v1',
    label: 'V1',
    path: '/v1',
    badge: 'Earlier exploration',
    title: 'Remaster of the agency design',
    line: 'The agency\'s original direction, rebuilt in code with pinned scenes that tell the story as you scroll.',
    points: ['Pinned full-screen scenes', 'Job fit and AI interview walkthroughs', 'Agency layout and type'],
  },
];

const changes = [
  'New header with Home, Login, Contact us, About us and a Get started button',
  'Hero image and two buttons next to the headline',
  'How it works rewritten as the product\'s 9 steps',
  'New audience section: every team, role and industry',
  'FAQ redesigned',
  'New footer',
  'Demos use dashboard data, and scores shown as percentages',
  'Animation only: the demos play themselves, no interactivity',
  'About, Contact and Terms and Policy pages',
];
const pages = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/terms', label: 'Terms and Policy' },
];
---
<Base title="Novara landing page, design variants" description="Four versions of the Novara landing page, side by side, for the DM team to compare." noindex>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm">Skip to content</a>
  <header class="border-b border-border-secondary bg-white">
    <div class="mx-auto flex h-16 w-full max-w-[84rem] items-center justify-between px-5 sm:px-8">
      <img src="/brand/novara-full.svg" width="143" height="41" alt="Novara" class="block h-7 w-auto" />
      <span class="rounded-full border border-border-secondary bg-bg px-3 py-1 text-xs font-medium text-text-tertiary">Internal comparison</span>
    </div>
  </header>

  <main id="main" class="font-ui">
    <section class="mx-auto w-full max-w-[84rem] px-5 pb-10 pt-14 sm:px-8 sm:pt-20" aria-labelledby="show-title">
      <p class="rise m-0 text-sm font-medium text-primary" style="--i:0">Design variants</p>
      <h1 id="show-title" class="rise m-0 mt-3 max-w-[46rem] font-display text-[clamp(2.25rem,1.5rem+3.2vw,4rem)] font-semibold leading-[1.04] tracking-[-0.03em] text-text-primary" style="--i:1">Novara landing page, design variants</h1>
      <p class="rise m-0 mt-5 max-w-[40rem] text-lg leading-relaxed text-text-secondary" style="--i:2">V1 to V3 are the earlier explorations. V4 is the page that includes the DM team's feedback. Open any card to see the full page.</p>
    </section>

    <section class="mx-auto w-full max-w-[84rem] px-5 pb-16 sm:px-8" aria-label="The four versions">
      <ul class="m-0 grid list-none gap-6 p-0 lg:grid-cols-2">
        {variants.map((v, n) => (
          <li class:list={['rise', v.featured && 'lg:col-span-2']} style={`--i:${n + 3}`}>
            <a href={v.path} class:list={['card group block h-full overflow-hidden rounded-2xl border bg-white no-underline shadow-xs', v.featured ? 'border-primary-300 lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]' : 'border-border-secondary']}>
              <div class:list={['flex flex-col p-6 sm:p-8', v.featured && 'lg:justify-center']}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-display text-2xl font-semibold tracking-[-0.02em] text-text-primary">{v.label}</span>
                  <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', v.featured ? 'bg-primary text-white' : 'bg-bg-tertiary text-text-tertiary']}>{v.badge}</span>
                </div>
                <h2 class="m-0 mt-4 font-display text-xl font-semibold tracking-[-0.02em] text-text-primary">{v.title}</h2>
                <p class="m-0 mt-2 text-base leading-relaxed text-text-secondary">{v.line}</p>
                <ul class="m-0 mt-4 grid list-none gap-1.5 p-0 text-sm text-text-tertiary">
                  {v.points.map((p) => <li class="flex gap-2"><span aria-hidden="true" class="mt-[0.45rem] size-1.5 shrink-0 rounded-full bg-primary-300"></span>{p}</li>)}
                </ul>
                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary">Open {v.label}<span aria-hidden="true" class="arrow">&rarr;</span></span>
              </div>
              <div class="preview-wrap border-t border-border-secondary bg-bg-tertiary lg:border-l lg:border-t-0">
                <div class="tile" aria-hidden="true"><span>{v.label}</span></div>
                <div class="frame" data-preview data-src={v.path}>
                  <div class="skeleton" aria-hidden="true"></div>
                  <iframe title={`Live preview of ${v.label}`} tabindex="-1" aria-hidden="true" loading="lazy" width="1440" height="900"></iframe>
                </div>
              </div>
              <noscript><span class="sr-only">Open {v.label}</span></noscript>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="border-t border-border-secondary bg-white" aria-labelledby="changes-title">
      <div class="mx-auto grid w-full max-w-[84rem] gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)]">
        <div>
          <h2 id="changes-title" class="m-0 font-display text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] font-semibold leading-tight tracking-[-0.02em] text-text-primary">What the DM feedback changed (V3 to V4)</h2>
          <p class="m-0 mt-3 text-base leading-relaxed text-text-secondary">The V4 pages also come with company pages of their own.</p>
          <ul class="m-0 mt-5 flex list-none flex-wrap gap-2 p-0">
            {pages.map((p) => <li><a href={p.href} class="inline-flex h-9 items-center rounded-md border border-border-primary bg-white px-3 text-sm font-medium text-text-secondary no-underline shadow-xs hover:bg-bg">{p.label}</a></li>)}
          </ul>
        </div>
        <ol class="m-0 grid list-none gap-3 p-0 sm:grid-cols-2">
          {changes.map((c, n) => (
            <li class="flex gap-3 rounded-lg border border-border-secondary bg-bg p-4 text-sm leading-relaxed text-text-secondary">
              <span class="grid size-6 shrink-0 place-items-center rounded-full bg-primary-100 text-xs font-semibold text-primary-700">{n + 1}</span>{c}
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <footer class="border-t border-border-secondary bg-bg">
    <div class="mx-auto w-full max-w-[84rem] px-5 py-6 sm:px-8"><p class="m-0 text-sm text-text-tertiary">Novara is a Vivasoft product. V1 to V3 are kept as they were and are not indexed.</p></div>
  </footer>
</Base>

<style is:global>
  .rise { animation: show-rise 0.6s var(--ease-out-quart, cubic-bezier(0.25, 1, 0.5, 1)) both; animation-delay: calc(var(--i, 0) * 70ms); }
  @keyframes show-rise { from { opacity: 0; transform: translateY(0.75rem); } to { opacity: 1; transform: none; } }
  .card { transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s; }
  .card:hover { box-shadow: 0 12px 32px -12px rgb(16 24 40 / 0.18); border-color: var(--color-primary-300); transform: translateY(-2px); }
  .card:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .card .arrow { transition: transform 0.2s; }
  .card:hover .arrow { transform: translateX(3px); }
  .preview-wrap { position: relative; min-height: 11rem; overflow: hidden; }
  .tile { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-200)); }
  .tile span { font-family: var(--font-display); font-size: 4rem; font-weight: 600; color: var(--color-primary-700); opacity: 0.55; }
  .frame { display: none; }
  @media (min-width: 768px) {
    .preview-wrap { min-height: 0; aspect-ratio: 16 / 10; }
    .tile { display: none; }
    .frame { display: block; position: absolute; inset: 0; background: #fff; }
    .frame iframe { position: absolute; left: 0; top: 0; width: 1440px; height: 900px; border: 0; transform-origin: 0 0; transform: scale(var(--s, 0.3)); pointer-events: none; opacity: 0; transition: opacity 0.4s; }
    .frame[data-ready] iframe { opacity: 1; }
    .skeleton { position: absolute; inset: 0; background: linear-gradient(100deg, var(--color-gray-100) 30%, #fff 50%, var(--color-gray-100) 70%) 0 0 / 200% 100%; animation: show-shimmer 1.6s linear infinite; }
    .frame[data-ready] .skeleton { display: none; }
  }
  @keyframes show-shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .card, .card .arrow { transition: none; }
    .card:hover { transform: none; }
    .skeleton { animation: none; }
  }
</style>

<script>
  const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-preview]'));
  const wide = window.matchMedia('(min-width: 768px)');
  const fit = (el: HTMLElement): void => el.style.setProperty('--s', String(el.clientWidth / 1440));
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target as HTMLElement)));
  const load = (el: HTMLElement): void => {
    const f = el.querySelector('iframe');
    if (!f || f.getAttribute('src') || !el.dataset['src']) return;
    f.addEventListener('load', () => el.setAttribute('data-ready', ''), { once: true });
    f.setAttribute('src', el.dataset['src']);
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        if (wide.matches) load(e.target as HTMLElement);
      }
    },
    { rootMargin: '200px' },
  );
  frames.forEach((el) => {
    ro.observe(el);
    fit(el);
    io.observe(el);
  });
</script>
