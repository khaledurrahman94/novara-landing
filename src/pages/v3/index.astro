---
import Base from '../../layouts/Base.astro';
import { v3 } from '../../content/v3';
import Nav from '../../components/v3/Nav.astro';
import Hero from '../../components/v3/Hero.astro';
import Results from '../../components/v3/Results.astro';
import ScreeningLab from '../../components/v3/labs/ScreeningLab.astro';
import InterviewLab from '../../components/v3/labs/InterviewLab.astro';
import Decide from '../../components/v3/Decide.astro';
import How from '../../components/v3/How.astro';
import Platform from '../../components/v3/Platform.astro';
import Faq from '../../components/v2/Faq.astro';
import Close from '../../components/v2/Close.astro';
import Footer from '../../components/v3/Footer.astro';
import '../../components/v2/v2.css';
import '../../components/v3/v3.css';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: v3.faq.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
<Base title={v3.seo.title} description={v3.seo.description} noindex fluid>
  <script is:inline>
    document.documentElement.classList.add('js');
    setTimeout(function () { document.documentElement.classList.add('js-fail'); }, 4000);
  </script>
  <div class="v2 v3 bg-white text-text-primary">
    <Nav />
    <main>
      <Hero />
      <Results />
      <ScreeningLab tone="white" />
      <InterviewLab tone="plate" />
      <Decide />
      <How />
      <Platform />
      <Faq />
      <Close />
    </main>
    <Footer />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<script>
  import { initV3 } from '../../components/v3/motion';
  initV3();
</script>
