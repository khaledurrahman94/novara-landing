---
import Page from '../layouts/Page.astro';
import PageHead from '../components/company/PageHead.astro';
import ContactForm from '../components/shared/ContactForm.astro';
import Button from '../components/home/Button.astro';
import { company, contact } from '../content/company';
const c = company.contact;
// PENDING DM TEAM CONFIRMATION: these details come from novara.my (see src/content/company.ts).
const rows: { label: string; text: string; href?: string }[] = [
  { label: c.labels.email, text: contact.email, href: `mailto:${contact.email}` },
  { label: c.labels.phone, text: contact.phone, href: contact.phoneHref },
  { label: c.labels.address, text: contact.address },
  { label: c.labels.website, text: contact.website, href: contact.website },
];
---
<Page title={c.seo.title} description={c.seo.description}>
  <PageHead eyebrow={c.eyebrow} title={c.title} line={c.line} />
  <div class="mx-auto w-full max-w-[75rem] border-x border-border-secondary px-5 py-12 sm:px-8 md:px-12 md:py-16">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <dl class="m-0 divide-y divide-border-secondary border-y border-border-secondary">
          {rows.map((r) => (
            <div class="grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
              <dt class="text-sm font-medium text-text-tertiary">{r.label}</dt>
              <dd class="m-0 text-base text-text-primary">
                {r.href ? <a href={r.href} class="text-primary-700 underline underline-offset-2 hover:text-primary-800">{r.text}</a> : r.text}
              </dd>
            </div>
          ))}
        </dl>
        <div class="mt-8"><Button href={c.demo.href}>{c.demo.label}</Button></div>
      </div>
      <div class="relative rounded-lg border border-border-secondary bg-white p-6 shadow-xs sm:p-8">
        <h2 class="m-0 mb-6 text-xl font-semibold text-text-primary">{c.form.title}</h2>
        <ContactForm id="contact-form" />
      </div>
    </div>
  </div>
</Page>
