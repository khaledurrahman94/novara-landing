---
import Base from '../layouts/Base.astro';
import InterviewLab from '../components/v3/labs/InterviewLab.astro';
import '../components/v2/v2.css';
---
<Base title="InterviewLab (R&D)" description="Test page for the V3 InterviewLab." noindex>
  <script is:inline>
    document.documentElement.classList.add('js');
  </script>
  <div class="v2 bg-white text-text-primary">
    <main>
      <div class="mx-auto flex min-h-[70vh] max-w-[1200px] items-end px-5 pb-10 sm:px-8 md:px-12">
        <p class="m-0 text-sm text-text-tertiary">Test page. Scroll room above the lab.</p>
      </div>
      <InterviewLab tone="plate" />
      <div class="mx-auto flex min-h-[80vh] max-w-[1200px] items-start border-t border-border-secondary px-5 pt-10 sm:px-8 md:px-12">
        <p class="m-0 text-sm text-text-tertiary">Test page. Scroll room below the lab.</p>
      </div>
    </main>
  </div>
</Base>
