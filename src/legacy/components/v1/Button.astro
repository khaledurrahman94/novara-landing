---
import Icon from '../shared/ui/Icon.astro';
interface Props { href: string; variant?: 'primary' | 'secondary' | 'inverse'; arrow?: boolean; class?: string }
const { href, variant = 'primary', arrow = false, class: cls = '' } = Astro.props;
const styles = {
  primary: 'bg-primary text-white hover:bg-primary-600 shadow-sm',
  secondary: 'border border-border-primary bg-bg-secondary text-text-secondary hover:bg-bg-tertiary shadow-xs',
  inverse: 'bg-white text-primary-700 hover:bg-primary-50 shadow-md',
};
---
<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 text-base font-semibold no-underline',
    'transition-[background-color,transform,box-shadow] duration-[var(--duration-fast)] ease-[var(--ease-out-quart)] active:scale-[0.98]',
    styles[variant],
    cls,
  ]}
>
  <slot />
  {arrow && <Icon name="arrow-up-right" size={16} class="transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-quart)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />}
</a>
