---
import { v1 } from '../../content/v1';
import { candidates } from '../../data/demo';
import SectionHead from './SectionHead.astro';
import Plate from '../shared/ui/Plate.astro';
import ScaleToFit from '../shared/ScaleToFit.astro';
import JobDraft from '../shared/ui/JobDraft.astro';
import ApplicantList from '../shared/ui/ApplicantList.astro';
import JobFitCard from '../shared/ui/JobFitCard.astro';
import SlotPicker from '../shared/ui/SlotPicker.astro';
import IntegrityPanel from '../shared/ui/IntegrityPanel.astro';
import PipelineBoard from '../shared/ui/PipelineBoard.astro';
const { how } = v1;
const design = [28, 40, 28, 26, 26, 40];
---
<section id="how" data-how data-scene aria-labelledby="how-title" class="scroll-mt-16 bg-bg-secondary">
  <div data-scene-stage class="scene-stage py-section">
    <div class="scene-inner mx-auto w-full max-w-[var(--v1-max,84rem)] px-gutter">
      <SectionHead id="how-title" eyebrow={how.eyebrow} title={how.title} class="scene-head" />
      <div class="scene-body">
        <ol class="how-list m-0 grid list-none gap-16 p-0 md:gap-20" aria-label={how.listLabel}>
          {how.steps.map((s, i) => (
            <li data-step class="how-step grid items-center gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12">
              <div data-step-text class="how-text">
                <h3 class="how-title m-0 font-display text-2xl font-semibold leading-tight tracking-[-0.02em] text-text-primary">{s.title}</h3>
                <div class="how-more">
                  <div class="how-more-in">
                    <p class="how-line m-0 mt-2 max-w-[26rem] text-lg leading-snug text-text-tertiary">{s.line}</p>
                    <span class="how-fill" aria-hidden="true"><span data-fill></span></span>
                  </div>
                </div>
              </div>
              <Plate caption={s.caption} parallax class="how-fig" innerClass="how-fig-inner">
                <ScaleToFit design={design[i] ?? 28}>
                  {i === 0 && <JobDraft />}
                  {i === 1 && <ApplicantList rows={candidates} />}
                  {i === 2 && <JobFitCard variant="full" />}
                  {i === 3 && <SlotPicker />}
                  {i === 4 && <IntegrityPanel />}
                  {i === 5 && <PipelineBoard />}
                </ScaleToFit>
              </Plate>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .how-fill { display: none; }

  [data-how][data-pinned] .how-list {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: 3rem;
    align-content: center;
    gap: 0.125rem 3rem;
    height: 100%;
  }
  [data-how][data-pinned] .how-step { display: contents; }
  [data-how][data-pinned] .how-text {
    grid-column: 1;
    padding: 0.375rem 0;
    cursor: pointer;
    border-radius: var(--radius-md);
  }
  [data-how][data-pinned] .how-title {
    font-size: 1.375rem;
    color: var(--color-text-placeholder);
    transition: color var(--duration-slow) var(--ease-out-quart);
  }
  [data-how][data-pinned] .how-text[data-active] .how-title { color: var(--color-text-primary); }
  [data-how][data-pinned] .how-more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows var(--duration-slow) var(--ease-out-quart), opacity var(--duration-slow) var(--ease-out-quart);
  }
  [data-how][data-pinned] .how-text[data-active] .how-more { grid-template-rows: 1fr; opacity: 1; }
  [data-how][data-pinned] .how-more-in { min-height: 0; overflow: hidden; }
  [data-how][data-pinned] .how-line { font-size: 1rem; margin-top: 0.25rem; }
  [data-how][data-pinned] .how-text:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  [data-how][data-pinned] .how-fill {
    display: block;
    height: 2px;
    max-width: 26rem;
    margin-top: 0.75rem;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--color-gray-200);
  }
  [data-how][data-pinned] .how-fill > span {
    display: block;
    height: 100%;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
  }
  [data-how][data-pinned] .how-fig {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: calc((100% - 3rem) * 7 / 12);
  }
</style>
