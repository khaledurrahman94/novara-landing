---
import Chip from '../shared/ui/Chip.astro';
import Icon from '../shared/ui/Icon.astro';
import { integrity } from '../../data/demo';
/** Integrity events as a horizontal track along the interview. Events are for a human to review. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const toSec = (t: string): number => {
  const [m = '0', s = '0'] = t.split(':');
  return Number(m) * 60 + Number(s);
};
const total = toSec(integrity.events[integrity.events.length - 1]?.time ?? '1');
const pos = ['items-start text-left', 'items-center text-center', 'items-end text-right'];
---
<div class:list={['rounded-lg border border-border-secondary bg-white p-5 font-ui text-text-primary shadow-md', cls]} data-card="integrity">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <div class="flex items-center gap-3">
      <p class="m-0 text-sm font-semibold">Integrity</p>
      <Chip tone="warning">{integrity.toReview} event to review</Chip>
    </div>
    <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
      {integrity.counters.map((c) => (
        <li class="flex items-center gap-2 text-xs text-text-tertiary">
          <Icon name={c.icon} size={14} />
          {c.label}
          <span class="text-sm font-semibold tabular-nums text-text-primary" data-anim="counter" data-count={c.value}>{c.value}</span>
        </li>
      ))}
    </ul>
  </div>

  <ol class="m-0 mt-5 flex list-none flex-col gap-3 p-0 md:hidden">
    {integrity.events.map((e) => (
      <li data-anim="event" data-flagged={e.flagged ? 'true' : undefined} class="flex items-start gap-3 text-[0.8125rem]">
        <span class:list={['mt-1 size-[0.6875rem] shrink-0 rounded-full border-2 bg-white', e.flagged ? 'border-warning' : 'border-border-primary']} aria-hidden="true"></span>
        <span>
          <span class="mr-1.5 tabular-nums text-text-tertiary">{e.time}</span>
          <span class:list={[e.flagged ? 'font-semibold' : 'text-text-secondary']}>{e.label}</span>
          {e.flagged && <span class="block text-xs text-text-tertiary">Flagged for your review</span>}
        </span>
      </li>
    ))}
  </ol>

  <ol class="relative m-0 mt-6 hidden h-[4.5rem] list-none p-0 md:block">
    <span class="absolute inset-x-0 top-[0.3125rem] h-px bg-border-primary" aria-hidden="true"></span>
    {integrity.events.map((e, i) => {
      const left = (toSec(e.time) / total) * 100;
      const place = i === 0 ? 'left-0' : i === integrity.events.length - 1 ? 'right-0' : '-translate-x-1/2';
      return (
        <li class:list={['absolute top-0 w-40', place]} style={i > 0 && i < integrity.events.length - 1 ? `left:${left.toFixed(2)}%` : undefined}>
          <span data-anim="event" data-flagged={e.flagged ? 'true' : undefined} class:list={['flex flex-col gap-1.5', pos[i === 0 ? 0 : i === integrity.events.length - 1 ? 2 : 1]]}>
            <span class:list={['size-[0.6875rem] rounded-full border-2 bg-white', e.flagged ? 'border-warning' : 'border-border-primary']} aria-hidden="true"></span>
            <span class="text-[0.8125rem]">
              <span class="mr-1.5 tabular-nums text-text-tertiary">{e.time}</span>
              <span class:list={[e.flagged ? 'font-semibold' : 'text-text-secondary']}>{e.label}</span>
              {e.flagged && <span class="block text-xs text-text-tertiary">Flagged for your review</span>}
            </span>
          </span>
        </li>
      );
    })}
  </ol>
</div>
