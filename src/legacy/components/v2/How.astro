---
import { v2 } from '../../content/v2';
import { byId, careerJobs, jobDraft, recruiter } from '../../data/demo';
import Section from './Section.astro';
import Avatar from '../shared/ui/Avatar.astro';
import Chip from '../shared/ui/Chip.astro';
import Icon from '../shared/ui/Icon.astro';
const { how } = v2;
const amara = byId('amara');
const nadia = byId('nadia');
const box = 'h-44 overflow-hidden rounded-lg border border-border-secondary bg-white p-3 font-ui text-text-primary';
---
<Section id="how" labelledby="how-title" tone="plate">
  <h2 id="how-title" class="m-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]">{how.title}</h2>

  <div data-how class="relative mt-14">
    <div class="absolute left-[0.875rem] right-0 top-[0.875rem] hidden h-px xl:block" aria-hidden="true">
      <div data-how-line="x" class="h-full origin-left bg-border-primary"></div>
    </div>
    <div class="absolute bottom-0 left-[0.875rem] top-[0.875rem] w-px xl:hidden" aria-hidden="true">
      <div data-how-line="y" class="h-full origin-top bg-border-primary"></div>
    </div>

    <ol class="m-0 grid list-none gap-10 p-0 xl:grid-cols-4 xl:gap-8">
      {how.steps.map((s, i) => (
        <li data-step class="relative pl-12 xl:pl-0">
          <span class="absolute left-0 top-0 grid size-7 place-items-center rounded-full border border-border-primary bg-white text-xs font-medium tabular-nums text-text-secondary xl:relative">{i + 1}</span>
          <div class="max-w-[30rem] xl:mt-6 xl:max-w-none">
            <div class={box} aria-hidden="true">
              {i === 0 && (
                <>
                  <div class="flex items-center justify-between"><span class="text-xs font-semibold">New job</span><Chip tone="primary"><Icon name="sparkles" size={11} />AI draft</Chip></div>
                  <p class="m-0 mt-3 rounded-md border border-border-secondary bg-white px-2.5 py-1.5 text-xs font-medium">{jobDraft.title}</p>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {jobDraft.skills.map((k) => <span class="rounded-sm bg-gray-100 px-2 py-0.5 text-[0.6875rem] font-medium text-text-secondary">{k}</span>)}
                  </div>
                  <ul class="m-0 mt-3 flex list-none flex-col gap-1 p-0 text-[0.6875rem] leading-snug text-text-secondary">
                    {jobDraft.lines.slice(0, 3).map((l) => <li class="truncate">{l}</li>)}
                  </ul>
                </>
              )}
              {i === 1 && (
                <>
                  <ul class="m-0 flex list-none flex-col gap-2 p-0">
                    {careerJobs.slice(0, 2).map((j) => (
                      <li class="flex items-center gap-2 rounded-md border border-border-secondary bg-white p-2">
                        <span class="min-w-0 flex-1 truncate text-xs font-semibold">{j.title}</span>
                        <span class="shrink-0 rounded-sm bg-primary px-2 py-1 text-[0.6875rem] font-medium text-white">Apply</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    <Chip tone="gray"><Icon name="globe" size={11} />Career page</Chip>
                    <Chip tone="gray"><Icon name="arrow-up-right" size={11} />Shared link</Chip>
                  </div>
                </>
              )}
              {i === 2 && (
                <ul class="m-0 flex list-none flex-col gap-2 p-0">
                  <li class="flex items-center gap-2 rounded-md border border-border-secondary bg-white p-2">
                    <Avatar initials={amara.initials} size="xs" lead /><span class="min-w-0 flex-1 truncate text-xs font-semibold">{amara.name}</span>
                    <span class="text-xs font-semibold tabular-nums">{amara.fit}</span>
                  </li>
                  <li class="flex items-center gap-2 rounded-md border border-border-secondary bg-white p-2">
                    <Avatar initials={nadia.initials} size="xs" /><span class="min-w-0 flex-1 truncate text-xs font-semibold">{nadia.name}</span>
                    <span class="text-xs font-semibold tabular-nums">{nadia.fit}</span>
                  </li>
                  <li class="flex items-center justify-between gap-2 pt-1">
                    <Chip tone="success">Qualified</Chip>
                    <span class="inline-flex items-center gap-1 rounded-sm border border-border-primary bg-white px-2 py-1 text-[0.6875rem] font-medium text-text-secondary"><Icon name="mic" size={11} />AI interview</span>
                  </li>
                </ul>
              )}
              {i === 3 && (
                <div class="flex h-full flex-col justify-between">
                  <div class="flex items-center gap-2 rounded-md border border-border-secondary bg-white p-2">
                    <Avatar initials={amara.initials} size="xs" lead /><span class="min-w-0 flex-1 truncate text-xs font-semibold">{amara.name}</span>
                    <Chip tone="success">Completed</Chip>
                  </div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="flex items-center gap-1.5 text-[0.6875rem] text-text-tertiary"><Avatar initials={recruiter.initials} size="xs" />{recruiter.first}</span>
                    <span class="inline-flex h-7 items-center rounded-md bg-primary px-2.5 text-[0.6875rem] font-medium text-white">Move to HR Round</span>
                  </div>
                </div>
              )}
            </div>
            <h3 class="m-0 mt-5 text-[1.0625rem] font-semibold tracking-[-0.01em]">{s.title}</h3>
            <p class="m-0 mt-1.5 text-[0.9375rem] leading-snug text-text-secondary">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Section>
