---
import { v3 } from '../../content/v3';
import { byId, careerJobs, candidates, jobDraft, recruiter } from '../../data/demo';
import Section from '../v2/Section.astro';
import Avatar from '../shared/ui/Avatar.astro';
import Chip from '../shared/ui/Chip.astro';
import Icon from '../shared/ui/Icon.astro';
const { how } = v3;
const amara = byId('amara');
const rank = [...candidates].sort((a, b) => b.fit - a.fit).slice(0, 3);
const wave = [0.4, 0.75, 0.55, 1, 0.65, 0.9, 0.5, 0.8, 0.45];
const applied = [byId('leo'), byId('marcus'), byId('nadia')];
const row = 'flex items-center gap-2 rounded-md border border-border-secondary bg-white p-2.5';
---
<Section id="how" labelledby="how-title" tone="plate">
  <div data-how class="v3-how">
    <div data-how-pin class="v3-how-pin">
      <div data-reveal>
        <h2 id="how-title" class="m-0 text-[clamp(1.875rem,1.3rem+1.8vw,2.75rem)] font-semibold leading-[1.08] tracking-[-0.03em]">{how.title}</h2>
      </div>
      <div data-how-progress hidden class="mt-8 h-px w-full bg-border-secondary" aria-hidden="true">
        <div data-how-line class="h-full origin-left bg-border-primary"></div>
      </div>
      <div data-how-viewport class="v3-how-viewport mt-10">
        <ol data-how-track class="v3-how-track m-0 grid list-none gap-14 p-0">
          {how.steps.map((s, i) => (
            <li data-step class="grid items-center gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] md:gap-12">
              <div>
                <span data-num class="grid size-7 place-items-center rounded-full border border-border-primary bg-white text-xs font-medium tabular-nums text-text-secondary transition-[background-color,color,border-color] duration-[var(--duration-base)]">{i + 1}</span>
                <h3 class="m-0 mt-5 text-[clamp(1.5rem,1.2rem+1vw,2rem)] font-semibold leading-tight tracking-[-0.02em]"><button type="button" data-step-btn data-cursor="Show" class="cursor-pointer rounded-sm p-0 text-left font-[inherit] text-inherit">{s.title}</button></h3>
                <p class="m-0 mt-2 max-w-[22rem] text-[0.9375rem] leading-snug text-text-secondary">{s.text}</p>
              </div>
              <div data-vignette={i} data-fit class="v3-fit font-ui text-text-primary" aria-hidden="true">
                <div data-fit-inner class="v3-fit-inner">
                {i === 0 && (
                  <>
                    <div class="flex items-center justify-between"><span class="text-sm font-semibold">New job</span><span data-v="chip"><Chip tone="primary"><Icon name="sparkles" size={11} />AI draft</Chip></span></div>
                    <p data-v="title" class="m-0 mt-4 rounded-md border border-border-secondary bg-white px-3 py-2 text-[0.8125rem] font-medium">{jobDraft.title}</p>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {jobDraft.skills.map((k) => <span data-v="skill" class="rounded-sm bg-gray-100 px-2 py-0.5 text-xs font-medium text-text-secondary">{k}</span>)}
                    </div>
                    <ul class="m-0 mt-4 flex list-none flex-col gap-2.5 p-0 text-[0.8125rem] leading-snug text-text-secondary">
                      {jobDraft.lines.map((l) => (
                        <li>{l.split(' ').map((w) => <><span data-v="word">{w}</span>{' '}</>)}</li>
                      ))}
                    </ul>
                  </>
                )}
                {i === 1 && (
                  <>
                    <div class="flex items-center gap-2 rounded-md bg-bg-tertiary px-3 py-2">
                      <span class="flex gap-1"><i class="size-2 rounded-full bg-border-primary"></i><i class="size-2 rounded-full bg-border-primary"></i><i class="size-2 rounded-full bg-border-primary"></i></span>
                      <span class="ml-2 flex-1 truncate rounded-sm bg-white px-2.5 py-1 text-[0.6875rem] text-text-tertiary">your-site.com/careers</span>
                    </div>
                    <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0">
                      {careerJobs.slice(0, 2).map((j) => (
                        <li class={row}>
                          <span class="min-w-0 flex-1 truncate text-[0.8125rem] font-semibold">{j.title}</span>
                          <span data-v="apply" class="shrink-0 rounded-sm bg-primary px-2 py-1 text-[0.6875rem] font-medium text-white">Apply</span>
                        </li>
                      ))}
                    </ul>
                    <p class="m-0 mt-4 text-xs font-semibold text-text-tertiary">New applications</p>
                    <ul class="m-0 mt-2 flex list-none flex-col gap-2 p-0">
                      {applied.map((c) => (
                        <li data-v="applied" class={row}>
                          <Avatar initials={c.initials} size="xs" /><span class="min-w-0 flex-1 truncate text-[0.8125rem] font-medium">{c.name}</span>
                          <Chip tone="gray">Applied</Chip>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {i === 2 && (
                  <>
                    <p class="m-0 text-xs font-semibold text-text-tertiary">Ranked by Job Fit Score</p>
                    <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0">
                      {rank.map((c) => (
                        <li data-v="fit-row" class={row}>
                          <Avatar initials={c.initials} size="xs" lead={c.id === 'amara'} />
                          <span class="w-24 shrink-0 truncate text-[0.8125rem] font-medium">{c.name}</span>
                          <span class="h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-gray-200"><span data-v="fit-bar" class="block h-full origin-left rounded-full bg-primary" style={`width:${c.fit}%`}></span></span>
                          <span data-v="fit-num" data-count={c.fit} class="w-7 text-right text-[0.8125rem] font-semibold tabular-nums">{c.fit}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="mt-4 flex items-center gap-3 rounded-md bg-bg-tertiary px-3 py-2.5">
                      <span data-v="interview" class="inline-flex shrink-0 items-center gap-1 text-[0.6875rem] font-medium text-text-secondary"><Icon name="mic" size={12} />AI interview</span>
                      <span class="flex h-5 shrink-0 items-center gap-[0.1875rem]" data-v="wave-box">
                        {wave.map((v) => <i data-v="wave" class="block w-[0.1875rem] rounded-full bg-primary" style={`height:${Math.round(v * 20)}px`}></i>)}
                      </span>
                      <span class="min-w-0 flex-1 truncate text-[0.75rem] text-text-secondary">{"Hi, I'm Novara's AI interviewer.".split(' ').map((w) => <><span data-v="cap">{w}</span>{' '}</>)}</span>
                      <span data-v="qualified"><Chip tone="success">Qualified</Chip></span>
                    </div>
                  </>
                )}
                {i === 3 && (
                  <div class="relative flex h-full flex-col">
                    <div class="grid grid-cols-2 gap-3">
                      <div data-v="from" class="rounded-md bg-bg-tertiary p-2">
                        <p class="m-0 mb-2 px-1 text-xs font-semibold text-text-secondary">{v3.decide.from}</p>
                        <div class="h-[5.5rem] rounded-md border border-dashed border-border-primary"></div>
                      </div>
                      <div data-v="to" class="rounded-md bg-bg-tertiary p-2">
                        <p class="m-0 mb-2 px-1 text-xs font-semibold text-text-secondary">{v3.decide.to}</p>
                        <div class="relative h-[5.5rem]">
                          <span class="absolute inset-0 rounded-md border border-dashed border-border-primary"></span>
                          <div data-v="card" class="absolute inset-0 flex flex-col justify-between rounded-md border border-primary bg-white p-2.5 shadow-md">
                            <div class="flex items-center gap-2"><Avatar initials={amara.initials} size="xs" lead /><span class="min-w-0 truncate text-xs font-semibold">{amara.name}</span></div>
                            <p data-v="stamp" class="m-0 flex items-center gap-1.5 text-[0.6875rem] font-medium text-text-secondary"><Avatar initials={recruiter.initials} size="xs" />Moved by {recruiter.first}</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Section>
