---
import { v3 } from '../../content/v3';
import { candidates, fit, integrity, interview, lead, role } from '../../data/demo';
import Avatar from '../shared/ui/Avatar.astro';
import Chip from '../shared/ui/Chip.astro';
import Icon from '../shared/ui/Icon.astro';
import ScoreRing from '../shared/ui/ScoreRing.astro';
import HeroChip from './HeroChip.astro';
const { hero } = v3;
const rail = ['window', 'users', 'briefcase', 'calendar', 'clipboard', 'globe'];
const flagged = integrity.events.find((e) => e.flagged);
/** The card edge only shows while a layer is pulled out of the frame. */
const edge = 'pointer-events-none absolute -inset-px -z-10 rounded-lg border border-border-primary bg-white opacity-0 shadow-lg';
---
<section data-hero id="top" aria-labelledby="hero-title" class="relative bg-white">
  <div class="mx-auto w-full max-w-[75rem] border-x border-border-secondary px-5 pb-20 pt-16 sm:px-8 md:px-12 md:pb-28 md:pt-24">
    <div class="max-w-[46rem]">
      <h1 id="hero-title" class="m-0 text-[clamp(2.75rem,1.2rem+5.2vw,4.5rem)] font-semibold leading-[1.02] tracking-[-0.03em]">{hero.title}</h1>
      <p data-rise class="m-0 mt-5 max-w-[34rem] text-lg leading-relaxed text-text-secondary">{hero.sub}</p>
      <p data-rise class="m-0 mt-7">
        <a href="#interview-lab" class="group inline-flex items-center gap-1.5 rounded-md text-base font-medium text-primary no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">
          {hero.secondary}
          <Icon name="arrow-right" size={16} class="rotate-90 transition-transform duration-200 ease-out group-hover:translate-y-0.5" />
        </a>
      </p>
    </div>

    <div data-shot data-hero-stage class="relative mt-8 py-10 md:mt-10 md:py-14">
      <div class="v2-horizon pointer-events-none absolute -top-8 left-[-10%] right-[-10%] h-[26rem] opacity-50" aria-hidden="true"></div>
      <figure class="relative m-0">
        <div data-frame data-ex="0,0.015,0.93,0" data-card="candidate-review" class="@container relative w-full rounded-xl border border-border-primary bg-white font-ui text-text-primary shadow-xl">
          <div class="flex min-h-[28rem]">
            <div class="hidden w-14 shrink-0 @xl:block">
              <div data-layer data-ex="-0.07,0.05,1.08,-4" class="relative isolate flex h-full flex-col items-center gap-1 rounded-l-xl border-r border-border-secondary bg-bg py-3" aria-hidden="true">
                <span data-edge class={edge}></span>
                <img src="/brand/novara-mark.svg" alt="" width="24" height="24" class="mb-3 size-6" />
                {rail.map((n) => (
                  <span class:list={['grid size-9 place-items-center rounded-md', n === 'users' ? 'bg-primary-50 text-primary' : 'text-text-placeholder']}>
                    <Icon name={n} size={18} />
                  </span>
                ))}
              </div>
            </div>

            <div class="hidden w-[19rem] shrink-0 @3xl:block">
              <div data-layer data-ex="-0.045,0.05,1.04,-2" class="relative isolate flex h-full flex-col border-r border-border-secondary" aria-hidden="true">
                <span data-edge class={edge}></span>
                <div class="border-b border-border-secondary px-4 py-3">
                  <p class="m-0 text-sm font-semibold">{role.title}</p>
                  <p class="m-0 text-xs text-text-tertiary">Ranked by Job Fit Score</p>
                </div>
                <ol class="m-0 list-none p-0">
                  {candidates.map((cd, i) => (
                    <li class:list={['relative flex items-center gap-3 px-4 py-3', i > 0 && 'border-t border-border-secondary', cd.id === 'amara' && 'bg-primary-50']}>
                      <Avatar initials={cd.initials} lead={cd.id === 'amara'} />
                      <div class="min-w-0 flex-1">
                        <p class="m-0 truncate text-[0.8125rem] font-semibold">{cd.name}</p>
                        <p class="m-0 truncate text-xs text-text-tertiary">{cd.note}</p>
                      </div>
                      <span class="text-sm font-semibold tabular-nums">{cd.fit}</span>
                      {cd.id === 'amara' && <HeroChip k="rank" />}
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            <div class="min-w-0 flex-1">
              <div data-layer data-ex="0.03,-0.02,1.03,1.5" class="relative isolate p-4 @lg:p-6">
                <span data-edge class={edge}></span>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-3">
                  <Avatar initials={lead.initials} size="md" lead />
                  <div class="min-w-0">
                    <p class="m-0 text-base font-semibold leading-tight">{lead.name}</p>
                    <p class="m-0 mt-0.5 flex items-center gap-2 text-xs text-text-tertiary">{role.short}<Chip tone="success">Completed</Chip></p>
                  </div>
                  <div class="flex w-full gap-2 @xl:ml-auto @xl:w-auto">
                    <span class="inline-flex h-9 items-center rounded-md border border-border-primary bg-white px-3 text-[0.8125rem] font-medium text-text-secondary shadow-xs">View recording</span>
                    <span class="relative inline-flex h-9 items-center gap-1.5 rounded-md bg-primary px-3 text-[0.8125rem] font-medium text-white shadow-xs">Move to HR Round<Icon name="arrow-right" size={14} />
                      <HeroChip k="moved" />
                    </span>
                  </div>
                </div>

                <div class="mt-5 grid grid-cols-1 gap-3 @md:grid-cols-3">
                  <div>
                    <div data-layer data-ex="-0.045,0.07,1.18,-5" class="relative isolate flex h-full flex-row items-center gap-3 rounded-lg border border-border-secondary p-3 @md:flex-col @md:items-start @md:gap-2 @lg:flex-row @lg:items-center @lg:gap-3 @lg:p-4">
                      <span data-edge class={edge}></span>
                      <ScoreRing score={fit.score} size={52} stroke={5} class="shrink-0" />
                      <div>
                        <p class="m-0 text-xs font-medium text-text-tertiary">Job Fit Score</p>
                        <p class="m-0 text-xs text-text-tertiary">Resume vs job</p>
                      </div>
                      <HeroChip k="fit" />
                    </div>
                  </div>
                  <div>
                    <div data-layer data-ex="0.01,0.085,1.1,2" class="relative isolate h-full rounded-lg border border-border-secondary p-3 @lg:p-4">
                      <span data-edge class={edge}></span>
                      <p class="m-0 text-xs font-medium text-text-tertiary">AI Interview Score</p>
                      <p class="m-0 mt-1 flex items-baseline gap-1">
                        <span class="text-[1.75rem] font-semibold leading-none tabular-nums" data-hero-count={interview.score}>{interview.score}</span>
                        <span class="text-xs text-text-tertiary">/ 100</span>
                      </p>
                      <HeroChip k="interview" />
                    </div>
                  </div>
                  <div>
                    <div data-layer data-ex="0.05,0.06,1.16,4" class="relative isolate h-full rounded-lg border border-border-secondary p-3 @lg:p-4">
                      <span data-edge class={edge}></span>
                      <p class="m-0 text-xs font-medium text-text-tertiary">Integrity</p>
                      <span class="mt-1.5 inline-block"><Chip tone="warning" class="!whitespace-normal">{integrity.toReview} event to review</Chip></span>
                      <HeroChip k="focus" />
                    </div>
                  </div>
                </div>

                <div class="mt-5 grid gap-5 @xl:grid-cols-2 @xl:gap-8">
                  <div>
                    <div data-layer data-ex="-0.03,0.075,1.06,-2" class="relative isolate rounded-lg">
                      <span data-edge class={edge}></span>
                      <p class="m-0 mb-2 text-xs font-semibold text-text-tertiary">Why this score</p>
                      <ul class="m-0 flex list-none flex-col gap-2 p-0">
                        {fit.matched.map((m, i) => (
                          <li class="relative flex items-center gap-2.5 text-[0.8125rem] text-text-secondary">
                            <span class="grid size-5 shrink-0 place-items-center rounded-full bg-success/10 text-text-secondary"><Icon name="check" size={12} /></span>{m}
                            {i === 0 && <HeroChip k="node" />}
                            {i === 1 && <HeroChip k="postgres" />}
                          </li>
                        ))}
                        {fit.missing.map((m) => (
                          <li class="relative flex items-center gap-2.5 text-[0.8125rem] text-text-secondary">
                            <span class="grid size-5 shrink-0 place-items-center rounded-full bg-warning/10 text-text-secondary"><Icon name="alert" size={12} /></span>
                            <span><span class="font-medium text-text-primary">Missing:</span> {m.label} <span class="text-text-tertiary">({m.note})</span></span>
                            <HeroChip k="k8s" />
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="hidden @xl:block">
                    <div data-layer data-ex="0.05,0.09,1.08,3" class="relative isolate rounded-lg">
                      <span data-edge class={edge}></span>
                      <p class="m-0 mb-2 text-xs font-semibold text-text-tertiary">Interview events</p>
                      <ol class="m-0 list-none p-0">
                        {integrity.events.map((e, i) => (
                          <li class="relative flex gap-3 pb-3 last:pb-0">
                            {i < integrity.events.length - 1 && <span class="absolute left-[0.3125rem] top-4 h-full w-px bg-border-secondary" aria-hidden="true"></span>}
                            <span class:list={['relative mt-1 size-[0.6875rem] shrink-0 rounded-full border-2 bg-white', e.flagged ? 'border-warning' : 'border-border-primary']} aria-hidden="true"></span>
                            <span class="min-w-0 flex-1 text-[0.8125rem]">
                              <span class="mr-2 tabular-nums text-text-tertiary">{e.time}</span>
                              <span class:list={[e.flagged ? 'font-semibold' : 'text-text-secondary']}>{e.label}</span>
                              {e.flagged && flagged && <span class="mt-0.5 block text-xs text-text-tertiary">Flagged for your review</span>}
                            </span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <figcaption class="sr-only">{hero.shotCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>
