---
import { toneBg, toneDot, type Tone } from './tone';
/** Status chip: tinted ground, dark text (contrast), tone carried by the dot. */
interface Props { tone?: Tone; dot?: boolean; class?: string }
const { tone = 'gray', dot = true, class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2 py-0.5 font-ui text-xs font-medium text-text-secondary', toneBg[tone], cls]}>
  {dot && <span class:list={['size-1.5 rounded-full', toneDot[tone]]} aria-hidden="true" />}
  <slot />
</span>
