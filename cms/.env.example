# Novara CMS (Strapi 5). Copy to .env and fill in. Never commit .env.
# Generate every secret with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Public URL of the CMS (admin and API), for example https://cms.example.com. Leave empty in local dev.
PUBLIC_URL=
# true when a reverse proxy terminates TLS in front of Strapi (production behind nginx, Caddy, a load balancer).
IS_PROXIED=false

# --- Secrets (all required) ---------------------------------------------------
# APP_KEYS takes four comma-separated values.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# --- Database -----------------------------------------------------------------
# sqlite for local dev, postgres in production.
DATABASE_CLIENT=sqlite
# sqlite only, relative to cms/ (default .tmp/data.db):
# DATABASE_FILENAME=.tmp/data.db
# postgres: either one connection string...
# DATABASE_URL=postgres://strapi:password@db:5432/strapi
# ...or the parts:
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# docker-compose only: the Postgres container reads these (and the app reuses them).
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=

# --- Media (any S3-compatible bucket) -----------------------------------------
# Unset S3_BUCKET and uploads go to public/uploads (dev only).
S3_BUCKET=
S3_REGION=auto
# Empty for AWS S3. Set for R2, MinIO, Spaces and others, for example https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the files (CDN or bucket domain), no trailing slash. Also allowed in the admin CSP.
S3_PUBLIC_URL=
# Optional key prefix inside the bucket, for example novara
S3_ROOT_PATH=
# true for most S3-compatible stores, false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Leave empty if the bucket has ACLs disabled (R2, modern AWS). Set public-read only if the bucket needs it.
S3_ACL=

# --- Site and preview ---------------------------------------------------------
# Origin of the Astro site. Enables the admin Preview button and allows it as a frame origin.
SITE_URL=http://localhost:4321
# Shared secret the site's /preview route checks. Use a long random value and set the same one on the site.
PREVIEW_SECRET=

# --- Rebuild on publish -------------------------------------------------------
# After a publish, unpublish, delete or media change, wait, then POST here. Unset means do nothing.
# Cloudflare deploy hook: just the hook URL.
# GitHub repository_dispatch: https://api.github.com/repos/<owner>/<repo>/dispatches plus a body and headers below.
DEPLOY_HOOK_URL=
# Optional raw body, for GitHub: {"event_type":"strapi-publish"}
DEPLOY_HOOK_BODY=
# Optional JSON object of headers, for GitHub: {"Authorization":"Bearer <token>","Accept":"application/vnd.github+json"}
DEPLOY_HOOK_HEADERS=
# Seconds to wait for edits to settle before posting (default 60).
DEPLOY_HOOK_DEBOUNCE_SECONDS=60

# --- Seed (only when running `pnpm seed` from outside the repo checkout) -------
# Folder holding src/content/v2.ts, src/content/v3.ts and public/robots.txt. Default: the repo root. The Docker image sets /seed.
# SEED_SRC_DIR=

# --- Misc ---------------------------------------------------------------------
STRAPI_TELEMETRY_DISABLED=true
FLAG_NPS=false
FLAG_PROMOTE_EE=false
